**/target/
/dist/
**/__pycache__/
**/*.rs.bk
/.worktrees/
*.pdb
**/mutants.out*/
# Scratch plans and notes are Markdown; generated run output stays local.
/.scratch/**/*
!/.scratch/**/
!/.scratch/**/*.md
# Keep generated documentation copies and local evidence archives out as well.
/.scratch/artifacts/
/.scratch/**/cache/
/.scratch/**/docs-bundle*/
/.scratch/**/compositor/
/.scratch/notify/freedesktop-completion-review/niribar-work/
/.scratch/notify/freedesktop-completion-review/ACTIVE-IMPLEMENTATION.md
/.scratch/notify/freedesktop-completion-review/NIRIBAR-CHANGED-FILES.txt
/.scratch/notify/freedesktop-completion-review/NIRIBAR-COMPLETION.patch
# Original UI alternatives are archived on prototype/niribar-vertical-ui.
/.scratch/niribar/vertical-ui-prototype/
# Files crash tests can retain private output beside the workspace/crate.
/.canopa-*/
/crates/canopa-files/.canopa-*/
/crates/canopa-files/.tmp*/
# Keep plans and investigation notes, not local logs, binaries or source archives.
/.scratch/file-manager/*
!/.scratch/file-manager/*.md
!/.scratch/file-manager/issues/
!/.scratch/file-manager/issues/*.md
