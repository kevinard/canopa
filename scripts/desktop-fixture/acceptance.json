    {"id": "idle-inhibitor-sway", "script": "verify-idle-inhibitor.py", "args": ["--binary", "{shell}", "--output", "{artifacts}", "--compositor", "sway"]},
    {"id": "idle-inhibitor-niri", "script": "verify-idle-inhibitor.py", "args": ["--binary", "{shell}", "--output", "{artifacts}", "--compositor", "niri"]}
