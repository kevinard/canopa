    {"id": "panel-motion", "script": "verify-panel-motion.py", "args": ["--binary", "{shell}", "--output", "{artifacts}", "--scale", "1.25"]},
    {"id": "panel-close-flash", "script": "verify-panel-motion.py", "args": ["--binary", "{shell}", "--output", "{artifacts}", "--scale", "1.25", "--default-timings", "--close-flash-only"]},
