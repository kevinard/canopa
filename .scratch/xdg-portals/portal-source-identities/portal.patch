+async fn stream_geometry(
+    connection: &Connection,
+    owner: &str,
+    path: &str,
+    source: &Source,
+    end: std::time::Instant,
+) -> anyhow::Result<Option<Geometry>> {
+    let Source::Monitor(monitor) = source else {
+        // Legacy Niri reports placeholder window geometry. The capture mapping
+        // extension will supply window regions separately to pointer workers.
+        return Ok(None);
+    };
+    let value: OwnedValue = call(
+        connection,
+        owner,
+        path,
+        "org.freedesktop.DBus.Properties",
+        "Get",
+        &(STREAM, "Parameters"),
+        remaining(end)?,
+    )
+    .await?;
+    let mut parameters = std::collections::HashMap::<String, OwnedValue>::try_from(value)?;
+    if let Some(expected) = monitor.identity() {
+        let actual = u64::try_from(
+            parameters
+                .remove("canopa-source-id")
+                .ok_or_else(|| anyhow::anyhow!("Missing capture source identity"))?,
+        )?;
+        anyhow::ensure!(actual == expected, "Capture monitor identity changed");
+    }
+    let position = parameters
+        .remove("position")
+        .ok_or_else(|| anyhow::anyhow!("Missing capture position"))?
+        .try_into()?;
+    let size = parameters
+        .remove("size")
+        .ok_or_else(|| anyhow::anyhow!("Missing capture size"))?
+        .try_into()?;
+    let geometry = Geometry { position, size };
+    anyhow::ensure!(geometry.valid(), "Invalid capture geometry");
+    Ok(Some(geometry))
+}
+
 fn remaining(end: std::time::Instant) -> anyhow::Result<Duration> {
     let remaining = end.saturating_duration_since(std::time::Instant::now());
     anyhow::ensure!(!remaining.is_zero(), "Capture start timed out");
