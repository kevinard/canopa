+            x: None,
+            y: Some(-120),
+        },
+    ] {
+        assert_eq!(
+            Command::decode(&command.packet(1, None), 1).unwrap(),
+            command
+        );
+    }
+    for command in [
+        Command::Relative { x: f64::NAN, y: 0. },
+        Command::Relative {
+            x: 1_000_001.,
+            y: 0.,
