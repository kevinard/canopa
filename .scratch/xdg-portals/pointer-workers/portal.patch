+#[test]
+fn pointer_wire_preserves_values_and_rejects_reserved_or_unbounded_input() {
+    for command in [
+        Command::Barrier,
+        Command::Relative { x: -1.5, y: 2.25 },
+        Command::Absolute {
+            node: 101,
+            x: 7.5,
+            y: 8.,
+        },
