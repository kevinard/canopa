schema-version 1
appearance {
    color-scheme "dark"
}
greeter {
    // Empty user list keeps manual username entry available.
    // users "alice" "bob"
    // default-user "alice"
    session "canopa" {
        label "Canopa"
        command { argv "niri-session"; }
        env "XDG_SESSION_TYPE=wayland" "XDG_SESSION_DESKTOP=canopa" "XDG_CURRENT_DESKTOP=canopa:niri"
    }
    view {
        widgets "keyboard" "battery"
        auth-timeout 120
        // image "/usr/local/share/canopa/login-background.jpg"
        dim 65
        layout {
            top-left "clock" "date"
            center "authentication"
            bottom-center "keyboard" "battery" flow="row"
        }
    }
}
