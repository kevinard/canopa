+    #[test]
+    fn pipe_round_trip_preserves_bytes_across_backpressure() {
+        let _serial = SERIAL.lock().unwrap();
+        let (read, write) = rustix::pipe::pipe().unwrap();
+        let bytes: Arc<[u8]> = (0..1024 * 1024)
+            .map(|i| (i % 256) as u8)
