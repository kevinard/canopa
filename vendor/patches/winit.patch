+//! Raw data-device dispatch keeps dropped offers independent of the next enter.
+use super::*;
+use sctk::{
+    globals::GlobalData,
+    reexports::client::{
+        event_created_child,
+        protocol::{
+            wl_data_device, wl_data_device_manager::WlDataDeviceManager, wl_data_offer,
+            wl_data_source,
