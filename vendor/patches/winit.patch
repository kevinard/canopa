+            }
+            if state.native.proxy.is_alive() {
+                if success {
+                    state.native.proxy.finish();
+                }
+                state.native.proxy.destroy();
+            }
+            state.snapshot.finished = true;
+            state.snapshot.id
+        };
+        if let Some(endpoint) = self.0.endpoint.upgrade() {
+            endpoint.offers.lock().unwrap().remove(&id);
+            endpoint.ping.ping();
+            (endpoint.changed)();
+        }
+        Ok(())
+    }
+}
