+            let mut state = offer.0.state.lock().unwrap();
+            state.snapshot.left = true;
+            if !state.snapshot.dropped {
+                state.snapshot.finished = true;
+                if state.native.proxy.is_alive() {
+                    state.native.proxy.destroy();
