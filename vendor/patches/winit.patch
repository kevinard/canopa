+            peers.push(write);
+        }
+        let (_read, write) = rustix::pipe::pipe().unwrap();
+        assert!(write_pipe(write, Arc::from(&b"x"[..]), WAIT, |_| panic!(
+            "refused worker ran"
+        ))
