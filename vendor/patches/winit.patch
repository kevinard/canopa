+impl Dispatch<wl_data_device::WlDataDevice, DeviceData> for WinitState {
+    event_created_child!(WinitState, wl_data_device::WlDataDevice, [0 => (WlDataOffer, OfferData::default())]);
+
+    fn event(
+        state: &mut Self,
+        _: &WlDataDevice,
+        event: wl_data_device::Event,
+        data: &DeviceData,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
