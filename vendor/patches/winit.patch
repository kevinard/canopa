+
+impl Dispatch<wl_data_source::WlDataSource, SourceData> for WinitState {
+    fn event(
+        state: &mut Self,
+        proxy: &WlDataSource,
+        event: wl_data_source::Event,
+        _: &SourceData,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
