+        let mut escape = ready();
+        escape.press(1, key("Escape", NUM));
+        assert_eq!(escape.state(), &State::Cancelled(CancelReason::User));
+        let mut a = ready();
+        a.press(1, key("a", 0));
+        assert_eq!(a.source(), Some(&1));
+        assert_eq!(a.pending_sequence(), Some(1));
