+    ) -> io::Result<Source> {
+        if self.0.closed.load(Ordering::Acquire)
+            || !self.0.surface.is_alive()
+            || self
+                .0
+                .requests
+                .upgrade()
+                .is_none_or(|requests| requests.closed.load(Ordering::Acquire))
+        {
+            return Err(error("The drag origin has closed"));
+        }
