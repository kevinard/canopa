+impl<T> Dispatch<XdgActivationV1, ()> for WindowState<T> {
+    fn event(
+        _state: &mut Self,
+        _proxy: &XdgActivationV1,
+        _event: xdg_activation_v1::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl<T> Dispatch<XdgActivationTokenV1, ()> for WindowState<T> {
+    fn event(
+        state: &mut Self,
+        proxy: &XdgActivationTokenV1,
+        event: xdg_activation_token_v1::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+        if let xdg_activation_token_v1::Event::Done { token } = event {
+            if let Some(callback) = state.pending_activation_tokens.remove(&proxy.id()) {
+                (callback.0)(Some(token));
+            }
+            proxy.destroy();
+        }
+    }
+}
