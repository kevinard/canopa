+            p.press(symbol(b'a' as u32), [0; 4]),
+            Err(Error::Unavailable)
+        );
+        assert_eq!(p.release(Key::Code(54)), Ok(vec![(54, false)]));
+    }
+    #[test]
+    fn french_altgr_symbol_retains_its_level_selector() {
