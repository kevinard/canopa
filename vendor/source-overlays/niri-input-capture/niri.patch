+                            state.serialize_mods(xkb::STATE_MODS_LOCKED),
+                            state.serialize_layout(xkb::STATE_LAYOUT_EFFECTIVE),
+                        ];
+                        let events = p.press(key, mods).unwrap_or_else(|error| {
+                            panic!(
