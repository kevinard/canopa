+            p.press(symbol(b'A' as u32), [shift, 0, 0, 0]),
+            Ok(vec![(42, true), (16, true)])
+        );
+        assert_eq!(
+            p.release(symbol(b'A' as u32)),
+            Ok(vec![(16, false), (42, false)])
+        );
+        assert_eq!(
