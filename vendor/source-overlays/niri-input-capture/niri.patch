+//! Canopa's compositor-owned input leases. This is not a portal consent service.
+//! The trusted portal owns grants and keeps its lease FD only while consent is active.
+//! Closing that FD releases this source without synthesizing release-triggered binds.
+
+use std::cell::RefCell;
+use std::io::Write;
+use std::net::Shutdown;
+use std::os::fd::OwnedFd;
+use std::os::unix::net::UnixStream;
+use std::rc::{Rc, Weak};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+
+use calloop::generic::Generic;
+use calloop::{Interest, Mode, PostAction};
+use smithay::backend::input::{InputEvent, KeyState, Keycode};
+use smithay::input::keyboard::{KeyboardSource, KeymapFileId};
+use zbus::{fdo, interface, zvariant};
+
+use super::Start;
+use crate::input::remote_keyboard::{
+    RemoteKeyboardBackend, RemoteKeyboardDevice, RemoteKeyboardKeyEvent,
+};
+use crate::niri::State;
+
+mod pointer;
+mod symbols;
+mod wire;
+use symbols::{Key, Planner};
+use wire::{HeldKeys, Reader, TypedReader, FRAMES_PER_DISPATCH};
+
+#[derive(Clone, Copy)]
+pub enum Protocol {
+    Evdev,
+    Symbols,
+}
+enum InputReader {
+    Evdev(Reader),
+    Symbols(TypedReader),
+}
+
+pub type MappingDescriptors = Vec<(u64, String, (i32, i32), f64)>;
+
+const MAX_LEASES: usize = 8;
+const MAX_KEYMAP: usize = 1024 * 1024;
+type Snapshot = (String, (u32, u32, u32, u32));
+
+pub struct RemoteInput {
+    to_niri: calloop::channel::SyncSender<Message>,
+    admission: Arc<AtomicUsize>,
+}
+
+pub struct Permit(Arc<AtomicUsize>);
+impl Permit {
+    fn acquire(admission: &Arc<AtomicUsize>) -> fdo::Result<Self> {
+        admission
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+                (n < MAX_LEASES).then_some(n + 1)
+            })
+            .map(|_| Self(admission.clone()))
+            .map_err(|_| fdo::Error::LimitsExceeded("too many input leases".into()))
+    }
+}
+impl Drop for Permit {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+pub enum Message {
+    Open {
+        stream: UnixStream,
+        protocol: Protocol,
+        permit: Permit,
+        reply: async_channel::Sender<fdo::Result<Snapshot>>,
+    },
+    Snapshot {
+        reply: async_channel::Sender<fdo::Result<Snapshot>>,
+    },
+    OpenMappedPointer {
+        stream: UnixStream,
+        permit: Permit,
+        session: String,
+        streams: Vec<String>,
+        reply: async_channel::Sender<fdo::Result<(u32, MappingDescriptors)>>,
+    },
+    OpenPointer {
+        stream: UnixStream,
+        permit: Permit,
+        reply: async_channel::Sender<fdo::Result<u32>>,
+    },
+}
+
+impl RemoteInput {
+    pub fn new(to_niri: calloop::channel::SyncSender<Message>) -> Self {
+        Self {
+            to_niri,
+            admission: Arc::new(AtomicUsize::new(0)),
+        }
+    }
+    fn send(&self, msg: Message) -> fdo::Result<()> {
+        self.to_niri
+            .try_send(msg)
+            .map_err(|_| fdo::Error::LimitsExceeded("input request queue unavailable".into()))
+    }
+    async fn open(
+        &self,
+        protocol: Protocol,
+    ) -> fdo::Result<(zvariant::OwnedFd, String, (u32, u32, u32, u32))> {
+        let permit = Permit::acquire(&self.admission)?;
+        let (client, server) = UnixStream::pair().map_err(|e| fdo::Error::Failed(e.to_string()))?;
+        server
+            .set_nonblocking(true)
+            .map_err(|e| fdo::Error::Failed(e.to_string()))?;
+        let (reply, receive) = async_channel::bounded(1);
+        self.send(Message::Open {
+            stream: server,
+            protocol,
+            permit,
+            reply,
+        })?;
+        let (keymap, mods) = receive
+            .recv()
+            .await
+            .map_err(|_| fdo::Error::Failed("compositor stopped".into()))??;
+        Ok((zvariant::OwnedFd::from(OwnedFd::from(client)), keymap, mods))
+    }
+}
+
+#[interface(name = "org.canopa.Niri.RemoteInput1")]
+impl RemoteInput {
+    /// Version 1: a keyboard-only lease, configured XKB keymap and current modifier masks.
+    /// The returned socket accepts fixed eight-byte evdev/state frames; EOF revokes it.
+    async fn open_keyboard(
+        &self,
+    ) -> fdo::Result<(zvariant::OwnedFd, String, (u32, u32, u32, u32))> {
+        self.open(Protocol::Evdev).await
+    }
+
+    /// Typed commands resolve symbols on this compositor's input thread.
+    /// The fixed command/reply formats are documented by remote_input::wire.
+    async fn open_keyboard_symbols(
+        &self,
+    ) -> fdo::Result<(zvariant::OwnedFd, String, (u32, u32, u32, u32))> {
+        self.open(Protocol::Symbols).await
+    }
+
+    #[zbus(property)]
+    fn symbol_version(&self) -> u32 {
+        1
+    }
+
+    /// FD-owned pointer commands with explicit acknowledgements. The capability
+    /// mask excludes absolute motion, which needs an approved live cast mapping.
+    async fn open_pointer(&self) -> fdo::Result<(zvariant::OwnedFd, u32)> {
+        let permit = Permit::acquire(&self.admission)?;
+        let (client, stream) = UnixStream::pair().map_err(|e| fdo::Error::Failed(e.to_string()))?;
+        stream
+            .set_nonblocking(true)
+            .map_err(|e| fdo::Error::Failed(e.to_string()))?;
+        let (reply, receive) = async_channel::bounded(1);
+        self.send(Message::OpenPointer {
+            stream,
+            permit,
+            reply,
+        })?;
+        let caps = receive
+            .recv()
+            .await
+            .map_err(|_| fdo::Error::Failed("compositor stopped".into()))??;
+        Ok((zvariant::OwnedFd::from(OwnedFd::from(client)), caps))
+    }
+
+    /// Bind absolute input to fixed, started streams of this capture session.
+    /// Region sizes and physical scales are immutable; changes retire the source.
+    async fn open_mapped_pointer(
+        &self,
+        session: zvariant::ObjectPath<'_>,
+        streams: Vec<zvariant::ObjectPath<'_>>,
+    ) -> fdo::Result<(zvariant::OwnedFd, u32, MappingDescriptors)> {
+        if streams.is_empty() || streams.len() > 16 {
+            return Err(fdo::Error::InvalidArgs(
+                "expected 1 to 16 capture streams".into(),
+            ));
+        }
+        let permit = Permit::acquire(&self.admission)?;
+        let (client, stream) = UnixStream::pair().map_err(|e| fdo::Error::Failed(e.to_string()))?;
+        stream
+            .set_nonblocking(true)
+            .map_err(|e| fdo::Error::Failed(e.to_string()))?;
+        let (reply, receive) = async_channel::bounded(1);
+        self.send(Message::OpenMappedPointer {
+            stream,
+            permit,
+            session: session.to_string(),
+            streams: streams.into_iter().map(|s| s.to_string()).collect(),
+            reply,
+        })?;
+        let (caps, descriptors) = receive
+            .recv()
+            .await
+            .map_err(|_| fdo::Error::Failed("compositor stopped".into()))??;
+        Ok((
+            zvariant::OwnedFd::from(OwnedFd::from(client)),
+            caps,
+            descriptors,
+        ))
+    }
+
+    #[zbus(property)]
+    fn mapped_pointer_version(&self) -> u32 {
+        2
+    }
+
+    #[zbus(property)]
+    fn pointer_version(&self) -> u32 {
+        1
+    }
+
+    /// Read authoritative state even while the portal has no focused Wayland surface.
+    async fn keyboard_snapshot(&self) -> fdo::Result<Snapshot> {
+        let (reply, receive) = async_channel::bounded(1);
+        self.send(Message::Snapshot { reply })?;
+        receive
+            .recv()
+            .await
+            .map_err(|_| fdo::Error::Failed("compositor stopped".into()))?
+    }
+
+    #[zbus(property)]
+    fn version(&self) -> u32 {
+        1
+    }
+}
+
+impl Start for RemoteInput {
+    fn start(self, _monitor: bool) -> anyhow::Result<zbus::blocking::Connection> {
+        Ok(zbus::blocking::connection::Builder::session()?
+            .name("org.canopa.Niri.RemoteInput1")?
+            .serve_at("/org/canopa/Niri/RemoteInput1", self)?
+            .build()?)
+    }
+}
+
+fn snapshot(state: &mut State) -> fdo::Result<Snapshot> {
+    let keyboard = state.niri.seat.get_keyboard().unwrap();
+    let map = keyboard.with_xkb_state(state, |ctx| ctx.xkb().lock().unwrap().keymap_as_string());
+    if map.is_empty() || map.len() >= MAX_KEYMAP {
+        return Err(fdo::Error::LimitsExceeded(
+            "keymap exceeds lease limit".into(),
+        ));
+    }
+    let m = keyboard.modifier_state().serialized;
+    Ok((map, (m.depressed, m.latched, m.locked, m.layout_effective)))
+}
+
+#[derive(Default, Clone)]
+pub struct Leases(Rc<RefCell<Vec<Weak<RefCell<Lease>>>>>, pointer::Leases);
+
+/// Publish seat state after compositor work and before its clients are flushed.
+/// Slow readers are retired instead of accumulating an unbounded output queue.
+pub fn refresh(state: &mut State) {
+    let Some(leases) = state
+        .niri
+        .dbus
+        .as_ref()
+        .map(|d| d.remote_input_leases.clone())
+    else {
+        return;
+    };
+    pointer::refresh(state, &leases.1);
+    let active: Vec<_> = {
+        let mut entries = leases.0.borrow_mut();
+        entries.retain(|entry| entry.strong_count() != 0);
+        entries.iter().filter_map(Weak::upgrade).collect()
+    };
+    if active.is_empty() {
+        return;
+    }
+    let keyboard = state.niri.seat.get_keyboard().unwrap();
+    let keymap = keyboard.keymap_id();
+    for lease in &active {
+        let mut lease = lease.borrow_mut();
+        if !lease.retired && lease.keymap != keymap {
+            lease.release(state);
+        }
+    }
+    for lease in active {
+        let mut lease = lease.borrow_mut();
+        if lease.retired {
+            continue;
+        }
+        let m = keyboard.modifier_state().serialized;
+        let mods = [m.depressed, m.latched, m.locked, m.layout_effective];
+        if mods != lease.last_mods {
+            if !lease.feedback(0, 0, mods) {
+                lease.release(state);
+            }
+        }
+    }
+}
+
+pub fn handle(state: &mut State, msg: Message, leases: &Leases) {
+    match msg {
+        Message::OpenMappedPointer {
+            stream,
+            permit,
+            session,
+            streams,
+            reply,
+        } => {
+            pointer::open_mapped(state, stream, permit, reply, &leases.1, &session, &streams);
+        }
+        Message::OpenPointer {
+            stream,
+            permit,
+            reply,
+        } => {
+            pointer::open(state, stream, permit, reply, &leases.1);
+        }
+        Message::Snapshot { reply } => {
+            let _ = reply.try_send(snapshot(state));
+        }
+        Message::Open {
+            stream,
+            protocol,
+            permit,
+            reply,
+        } => {
+            state.restore_configured_keymap();
+            let initial = match snapshot(state) {
+                Ok(s) => s,
+                Err(e) => {
+                    let _ = reply.try_send(Err(e));
+                    return;
+                }
+            };
+            let writer = match stream.try_clone() {
+                Ok(writer) => writer,
+                Err(e) => {
+                    let _ = reply.try_send(Err(fdo::Error::Failed(e.to_string())));
+                    return;
+                }
+            };
+            let keymap = state.niri.seat.get_keyboard().unwrap().keymap_id();
+            let lease = Lease {
+                _permit: permit,
+                device: RemoteKeyboardDevice {
+                    source: KeyboardSource::new_auxiliary(),
+                },
+                protocol,
+                reader: match protocol {
+                    Protocol::Evdev => InputReader::Evdev(Reader::default()),
+                    Protocol::Symbols => InputReader::Symbols(TypedReader::default()),
+                },
+                symbols: Planner::default(),
+                held: HeldKeys::default(),
+                keymap,
+                writer,
+                last_mods: [initial.1 .0, initial.1 .1, initial.1 .2, initial.1 .3],
+                retired: false,
+            };
+            let lease = Rc::new(RefCell::new(lease));
+            leases.0.borrow_mut().push(Rc::downgrade(&lease));
+            let result = state.niri.event_loop.insert_source(
+                Generic::new(stream, Interest::READ, Mode::Level),
+                move |_, socket, state| {
+                    let mut lease = lease.borrow_mut();
+                    if lease.retired {
+                        return Ok(PostAction::Remove);
+                    }
+                    let mut socket = &**socket;
+                    for _ in 0..FRAMES_PER_DISPATCH {
+                        let event = match &mut lease.reader {
+                            InputReader::Evdev(reader) => reader.next(&mut socket).map(|event| {
+                                event.map(|(key, pressed)| (0, Key::Code(key), pressed))
+                            }),
+                            InputReader::Symbols(reader) => reader.next(&mut socket),
+                        };
+                        match event {
+                            Ok(None) => return Ok(PostAction::Continue),
+                            Ok(Some((sequence, key, pressed))) => {
+                                if state.niri.seat.get_keyboard().unwrap().keymap_id()
+                                    != lease.keymap
+                                {
+                                    lease.release(state);
+                                    return Ok(PostAction::Remove);
+                                }
+                                let transitions = match lease.protocol {
+                                    Protocol::Evdev => match key {
+                                        Key::Code(code) => Ok(vec![(code, pressed)]),
+                                        Key::Symbol(_) => unreachable!(),
+                                    },
+                                    Protocol::Symbols => {
+                                        let keyboard = state.niri.seat.get_keyboard().unwrap();
+                                        let m = keyboard.modifier_state().serialized;
+                                        keyboard.with_xkb_state(state, |ctx| {
+                                            let xkb = ctx.xkb().lock().unwrap();
+                                            if pressed {
+                                                // No reference or cloned map escapes the guard;
+                                                // the planner retains only numeric key chords.
+                                                lease.symbols.press(
+                                                    unsafe { xkb.keymap() },
+                                                    key,
+                                                    [
+                                                        m.depressed,
+                                                        m.latched,
+                                                        m.locked,
+                                                        m.layout_effective,
+                                                    ],
+                                                )
+                                            } else {
+                                                lease.symbols.release(key)
+                                            }
+                                        })
+                                    }
+                                };
+                                let status = match transitions {
+                                    Ok(transitions) => {
+                                        for (key, pressed) in transitions {
+                                            if lease.held.transition(key, pressed).is_err() {
+                                                lease.release(state);
+                                                return Ok(PostAction::Remove);
+                                            }
+                                            state.process_input_event::<RemoteKeyboardBackend>(
+                                                InputEvent::Keyboard {
+                                                    event: RemoteKeyboardKeyEvent {
+                                                        device: lease.device.clone(),
+                                                        key,
+                                                        state: if pressed {
+                                                            KeyState::Pressed
+                                                        } else {
+                                                            KeyState::Released
+                                                        },
+                                                    },
+                                                },
+                                            );
+                                        }
+                                        0
+                                    }
+                                    Err(symbols::Error::Invalid) => 1,
+                                    Err(symbols::Error::Unavailable) => 2,
+                                    Err(symbols::Error::Conflict) => 3,
+                                    Err(symbols::Error::Limit) => 4,
+                                };
+                                if sequence != 0 {
+                                    let m = state
+                                        .niri
+                                        .seat
+                                        .get_keyboard()
+                                        .unwrap()
+                                        .modifier_state()
+                                        .serialized;
+                                    if !lease.feedback(
+                                        sequence,
+                                        status,
+                                        [m.depressed, m.latched, m.locked, m.layout_effective],
+                                    ) {
+                                        lease.release(state);
+                                        return Ok(PostAction::Remove);
+                                    }
+                                }
+                            }
+                            Err(_) => {
+                                lease.release(state);
+                                return Ok(PostAction::Remove);
+                            }
+                        }
+                    }
+                    Ok(PostAction::Continue)
+                },
+            );
+            let response = result
+                .map(|_| initial)
+                .map_err(|e| fdo::Error::Failed(e.to_string()));
+            let _ = reply.try_send(response);
+        }
+    }
+}
+
+struct Lease {
+    _permit: Permit,
+    device: RemoteKeyboardDevice,
+    protocol: Protocol,
+    reader: InputReader,
+    symbols: Planner,
+    held: HeldKeys,
+    keymap: KeymapFileId,
+    writer: UnixStream,
+    last_mods: [u32; 4],
+    retired: bool,
+}
+impl Lease {
+    fn feedback(&mut self, sequence: u32, status: u32, mods: [u32; 4]) -> bool {
+        let typed;
+        let evdev;
+        let bytes: &[u8] = match self.protocol {
+            Protocol::Evdev => {
+                evdev = mods
+                    .into_iter()
+                    .flat_map(u32::to_le_bytes)
+                    .collect::<Vec<_>>();
+                &evdev
+            }
+            Protocol::Symbols => {
+                typed = wire::feedback(sequence, status, mods);
+                &typed
+            }
+        };
+        if self.writer.write(bytes).ok() != Some(bytes.len()) {
+            return false;
+        }
+        self.last_mods = mods;
+        true
+    }
+    fn release(&mut self, state: &mut State) {
+        if self.retired {
+            return;
+        }
+        self.retired = true;
+        let _ = self.writer.shutdown(Shutdown::Both);
+        let keyboard = state.niri.seat.get_keyboard().unwrap();
+        keyboard.release_source(state, self.device.source);
+        let still_held = keyboard.pressed_keys();
+        for key in self.held.keys() {
+            let key = Keycode::from(*key + 8);
+            if !still_held.contains(&key) {
+                state.niri.pending_release_binds.remove(&key);
+                state.niri.suppressed_keys.remove(&key);
+            }
+        }
+        if !self.held.keys().is_empty() {
+            if let Some(token) = state.niri.bind_repeat_timer.take() {
+                state.niri.event_loop.remove(token);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn admission_is_bounded_and_recovers_after_drop() {
+        let admission = Arc::new(AtomicUsize::new(0));
+        let permits: Vec<_> = (0..MAX_LEASES)
+            .map(|_| Permit::acquire(&admission).unwrap())
+            .collect();
+        assert!(Permit::acquire(&admission).is_err());
+        drop(permits);
+        assert_eq!(admission.load(Ordering::Relaxed), 0);
+        assert!(Permit::acquire(&admission).is_ok());
+    }
+}
diff --git a/src/dbus/remote_input/pointer.rs b/src/dbus/remote_input/pointer.rs
--- /dev/null
+++ b/src/dbus/remote_input/pointer.rs
@@ -0,0 +1,265 @@
+//! FD-owned relative pointer, button and scroll transport. Absolute motion needs
+//! a separate live capture-source mapping; this socket never falls back to the
+//! whole desktop's bounding rectangle. The portal still owns authorization/UI.
+
+use std::cell::RefCell;
+use std::io::Write;
+use std::net::Shutdown;
+use std::os::unix::net::UnixStream;
+use std::rc::{Rc, Weak};
+
+use calloop::generic::Generic;
+use calloop::{Interest, Mode, PostAction};
+use smithay::backend::input::{AxisSource, ButtonState, InputEvent, InputTime};
+use zbus::fdo;
+
+use super::Permit;
+use crate::input::remote_pointer::{
+    RemotePointerAbsoluteEvent, RemotePointerAxisEvent, RemotePointerBackend,
+    RemotePointerButtonEvent, RemotePointerDevice, RemotePointerMotionEvent,
+};
+use crate::niri::State;
+use crate::screencasting::sources::mapping::Bindings;
+
+mod wire;
+use wire::{Buttons, Command, Reader, COMMANDS_PER_DISPATCH};
+
+/// Relative motion, buttons, continuous/finger scrolling, discrete v120 scrolling.
+/// No absolute or touch bit is included.
+pub const CAPABILITIES: u32 = 1 | 2 | 4 | 8;
+
+#[derive(Default, Clone)]
+pub struct Leases(Rc<RefCell<Vec<Weak<RefCell<Lease>>>>>);
+
+pub fn refresh(state: &mut State, leases: &Leases) {
+    let active: Vec<_> = {
+        let mut entries = leases.0.borrow_mut();
+        entries.retain(|entry| entry.strong_count() != 0);
+        entries.iter().filter_map(Weak::upgrade).collect()
+    };
+    for lease in active {
+        let mut lease = lease.borrow_mut();
+        if state.niri.is_locked()
+            || lease
+                .bindings
+                .as_ref()
+                .is_some_and(|b| !b.valid(&state.niri))
+        {
+            lease.release(state);
+        }
+    }
+}
+
+pub fn open(
+    state: &mut State,
+    stream: UnixStream,
+    permit: Permit,
+    reply: async_channel::Sender<fdo::Result<u32>>,
+    leases: &Leases,
+) {
+    open_inner(state, stream, permit, reply, leases, None);
+}
+
+pub fn open_mapped(
+    state: &mut State,
+    stream: UnixStream,
+    permit: Permit,
+    reply: async_channel::Sender<fdo::Result<(u32, super::MappingDescriptors)>>,
+    leases: &Leases,
+    session: &str,
+    streams: &[String],
+) {
+    let bindings = match Bindings::new(&state.niri, session, streams) {
+        Ok(bindings) => bindings,
+        Err(error) => {
+            let _ = reply.try_send(Err(error));
+            return;
+        }
+    };
+    let descriptors = bindings.descriptors();
+    let (inner_reply, receive) = async_channel::bounded(1);
+    open_inner(state, stream, permit, inner_reply, leases, Some(bindings));
+    let result = receive
+        .try_recv()
+        .unwrap_or_else(|_| Err(fdo::Error::Failed("pointer setup did not finish".into())));
+    let _ = reply.try_send(result.map(|caps| (caps, descriptors)));
+}
+
+fn open_inner(
+    state: &mut State,
+    stream: UnixStream,
+    permit: Permit,
+    reply: async_channel::Sender<fdo::Result<u32>>,
+    leases: &Leases,
+    bindings: Option<Bindings>,
+) {
+    if state.niri.is_locked() {
+        let _ = reply.try_send(Err(fdo::Error::AccessDenied("session is locked".into())));
+        return;
+    }
+    let Some(device) = RemotePointerDevice::new() else {
+        let _ = reply.try_send(Err(fdo::Error::LimitsExceeded(
+            "pointer source identities exhausted".into(),
+        )));
+        return;
+    };
+    let writer = match stream.try_clone() {
+        Ok(writer) => writer,
+        Err(error) => {
+            let _ = reply.try_send(Err(fdo::Error::Failed(error.to_string())));
+            return;
+        }
+    };
+    let lease = Rc::new(RefCell::new(Lease {
+        _permit: permit,
+        device,
+        reader: Reader::default(),
+        buttons: Buttons::default(),
+        writer,
+        retired: false,
+        bindings,
+    }));
+    let capabilities = CAPABILITIES
+        | if lease.borrow().bindings.is_some() {
+            16
+        } else {
+            0
+        };
+    leases.0.borrow_mut().push(Rc::downgrade(&lease));
+    let result = state.niri.event_loop.insert_source(
+        Generic::new(stream, Interest::READ, Mode::Level),
+        move |_, socket, state| {
+            let mut lease = lease.borrow_mut();
+            if lease.retired {
+                return Ok(PostAction::Remove);
+            }
+            if state.niri.is_locked()
+                || lease
+                    .bindings
+                    .as_ref()
+                    .is_some_and(|b| !b.valid(&state.niri))
+            {
+                lease.release(state);
+                return Ok(PostAction::Remove);
+            }
+            let mut socket = &**socket;
+            for _ in 0..COMMANDS_PER_DISPATCH {
+                let (sequence, command) = match lease.reader.next(&mut socket) {
+                    Ok(Some(command)) => command,
+                    Ok(None) => return Ok(PostAction::Continue),
+                    Err(_) => {
+                        lease.release(state);
+                        return Ok(PostAction::Remove);
+                    }
+                };
+                if lease.dispatch(state, command).is_err()
+                    || lease.writer.write(&wire::feedback(sequence)).ok() != Some(16)
+                {
+                    lease.release(state);
+                    return Ok(PostAction::Remove);
+                }
+            }
+            Ok(PostAction::Continue)
+        },
+    );
+    let _ = reply.try_send(
+        result
+            .map(|_| capabilities)
+            .map_err(|e| fdo::Error::Failed(e.to_string())),
+    );
+}
+
+struct Lease {
+    _permit: Permit,
+    device: RemotePointerDevice,
+    reader: Reader,
+    buttons: Buttons,
+    writer: UnixStream,
+    retired: bool,
+    bindings: Option<Bindings>,
+}
+impl Lease {
+    fn dispatch(&mut self, state: &mut State, command: Command) -> std::io::Result<()> {
+        let device = self.device.clone();
+        let time = InputTime::now();
+        match command {
+            Command::Barrier => {}
+            Command::Absolute { x, y, stream } => {
+                state.niri.advance_animations();
+                let position = self
+                    .bindings
+                    .as_ref()
+                    .and_then(|b| b.point(&state.niri, stream, x, y))
+                    .ok_or(std::io::ErrorKind::InvalidData)?;
+                state.process_input_event::<RemotePointerBackend>(
+                    InputEvent::PointerMotionAbsolute {
+                        event: RemotePointerAbsoluteEvent {
+                            device,
+                            time,
+                            position,
+                        },
+                    },
+                );
+            }
+            Command::Relative { x, y } => {
+                state.process_input_event::<RemotePointerBackend>(InputEvent::PointerMotion {
+                    event: RemotePointerMotionEvent { device, time, x, y },
+                })
+            }
+            Command::Button { code, pressed } => {
+                self.buttons.transition(code, pressed)?;
+                state.process_input_event::<RemotePointerBackend>(InputEvent::PointerButton {
+                    event: RemotePointerButtonEvent {
+                        device,
+                        time,
+                        code,
+                        state: if pressed {
+                            ButtonState::Pressed
+                        } else {
+                            ButtonState::Released
+                        },
+                    },
+                });
+            }
+            Command::Scroll { x, y, finger } => {
+                state.process_input_event::<RemotePointerBackend>(InputEvent::PointerAxis {
+                    event: RemotePointerAxisEvent {
+                        device,
+                        time,
+                        x,
+                        y,
+                        source: if finger {
+                            AxisSource::Finger
+                        } else {
+                            AxisSource::Continuous
+                        },
+                        discrete: false,
+                    },
+                })
+            }
+            Command::Wheel { x, y } => {
+                state.process_input_event::<RemotePointerBackend>(InputEvent::PointerAxis {
+                    event: RemotePointerAxisEvent {
+                        device,
+                        time,
+                        x: x.map(f64::from),
+                        y: y.map(f64::from),
+                        source: AxisSource::Wheel,
+                        discrete: true,
+                    },
+                })
+            }
+        }
+        Ok(())
+    }
+    fn release(&mut self, state: &mut State) {
+        if self.retired {
+            return;
+        }
+        self.retired = true;
+        state.retire_pointer_device(&self.device);
+        // EOF is observable only after the compositor has synchronously retired
+        // this exact source, including consumed presses and owned grabs.
+        let _ = self.writer.shutdown(Shutdown::Both);
+    }
+}
diff --git a/src/dbus/remote_input/pointer/wire.rs b/src/dbus/remote_input/pointer/wire.rs
--- /dev/null
+++ b/src/dbus/remote_input/pointer/wire.rs
@@ -0,0 +1,364 @@
+//! Pointer lease v1: 32-byte little-endian commands (sequence, kind, a, b, c).
+//! Sequence/kind are u32; payload words are u64. Sequences start at one and never
+//! wrap. No read-ahead, variable allocation, descriptor input or queued output.
+//! 0: barrier, zero payload. 1: relative f64 x/y, c=0. 2: button code/state,
+//! c=0. 3: scroll f64 x/y, c flags (horizontal=1, vertical=2, finger=4).
+//! 4: wheel signed i64 v120 x/y, c axis flags. Unselected axes must be zero.
+//! 5: absolute f64 x/y, c=selected stream ID; only OpenMappedPointer accepts it.
+//! Replies are 16 bytes: sequence, status=0 and two reserved zero u32 words.
+//! Invalid input retires the source without acknowledging that command.
+
+use std::collections::BTreeSet;
+use std::io::{self, Read};
+
+pub const COMMANDS_PER_DISPATCH: usize = 32;
+pub const MAX_BUTTONS: usize = 64;
+const MAX_AMOUNT: f64 = 1_000_000.;
+const MAX_V120: i64 = 120 * 32;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Command {
+    Barrier,
+    Relative {
+        x: f64,
+        y: f64,
+    },
+    Absolute {
+        x: f64,
+        y: f64,
+        stream: u64,
+    },
+    Button {
+        code: u32,
+        pressed: bool,
+    },
+    Scroll {
+        x: Option<f64>,
+        y: Option<f64>,
+        finger: bool,
+    },
+    Wheel {
+        x: Option<i32>,
+        y: Option<i32>,
+    },
+}
+
+#[derive(Default)]
+pub struct Reader {
+    bytes: [u8; 32],
+    filled: usize,
+    sequence: u32,
+}
+impl Reader {
+    pub fn next(&mut self, read: &mut impl Read) -> io::Result<Option<(u32, Command)>> {
+        while self.filled < self.bytes.len() {
+            match read.read(&mut self.bytes[self.filled..]) {
+                Ok(0) => return Err(io::ErrorKind::UnexpectedEof.into()),
+                Ok(n) => self.filled += n,
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock => return Ok(None),
+                Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
+                Err(e) => return Err(e),
+            }
+        }
+        self.filled = 0;
+        let sequence = u32::from_le_bytes(self.bytes[0..4].try_into().unwrap());
+        let kind = u32::from_le_bytes(self.bytes[4..8].try_into().unwrap());
+        let a = u64::from_le_bytes(self.bytes[8..16].try_into().unwrap());
+        let b = u64::from_le_bytes(self.bytes[16..24].try_into().unwrap());
+        let c = u64::from_le_bytes(self.bytes[24..32].try_into().unwrap());
+        if self.sequence.checked_add(1) != Some(sequence) {
+            return Err(io::ErrorKind::InvalidData.into());
+        }
+        let amount = |bits| {
+            let value = f64::from_bits(bits);
+            (value.is_finite() && value.abs() <= MAX_AMOUNT).then_some(value)
+        };
+        let command = match (kind, a, b, c) {
+            (0, 0, 0, 0) => Some(Command::Barrier),
+            (1, a, b, 0) => amount(a)
+                .zip(amount(b))
+                .map(|(x, y)| Command::Relative { x, y }),
+            (2, 1..=0xffff, 0..=1, 0) => Some(Command::Button {
+                code: a as u32,
+                pressed: b == 1,
+            }),
+            (3, a, b, flags @ 1..=7) if flags & 3 != 0 => {
+                amount(a).zip(amount(b)).and_then(|(x, y)| {
+                    ((flags & 1 != 0 || x == 0.) && (flags & 2 != 0 || y == 0.)).then_some(
+                        Command::Scroll {
+                            x: (flags & 1 != 0).then_some(x),
+                            y: (flags & 2 != 0).then_some(y),
+                            finger: flags & 4 != 0,
+                        },
+                    )
+                })
+            }
+            (4, a, b, flags @ 1..=3) => {
+                let (x, y) = (a as i64, b as i64);
+                let valid = |value: i64, selected| {
+                    if selected {
+                        value != 0 && (-MAX_V120..=MAX_V120).contains(&value)
+                    } else {
+                        value == 0
+                    }
+                };
+                (valid(x, flags & 1 != 0) && valid(y, flags & 2 != 0)).then_some(Command::Wheel {
+                    x: (flags & 1 != 0).then_some(x as i32),
+                    y: (flags & 2 != 0).then_some(y as i32),
+                })
+            }
+            (5, a, b, stream) if stream != 0 => amount(a)
+                .zip(amount(b))
+                .filter(|(x, y)| *x >= 0. && *y >= 0.)
+                .map(|(x, y)| Command::Absolute { x, y, stream }),
+            _ => None,
+        }
+        .ok_or(io::ErrorKind::InvalidData)?;
+        self.sequence = sequence;
+        Ok(Some((sequence, command)))
+    }
+}
+
+#[derive(Default)]
+pub struct Buttons(BTreeSet<u32>);
+impl Buttons {
+    pub fn transition(&mut self, code: u32, pressed: bool) -> io::Result<()> {
+        if pressed {
+            if self.0.len() >= MAX_BUTTONS || !self.0.insert(code) {
+                return Err(io::ErrorKind::InvalidData.into());
+            }
+        } else if !self.0.remove(&code) {
+            return Err(io::ErrorKind::InvalidData.into());
+        }
+        Ok(())
+    }
+}
+
+pub fn feedback(sequence: u32) -> [u8; 16] {
+    let mut bytes = [0; 16];
+    bytes[..4].copy_from_slice(&sequence.to_le_bytes());
+    bytes
+}
+
+#[cfg(test)]
+mod tests {
+    use std::collections::VecDeque;
+
+    use super::*;
+    fn packet(sequence: u32, kind: u32, a: u64, b: u64, c: u64) -> Vec<u8> {
+        [
+            sequence.to_le_bytes().as_slice(),
+            kind.to_le_bytes().as_slice(),
+            a.to_le_bytes().as_slice(),
+            b.to_le_bytes().as_slice(),
+            c.to_le_bytes().as_slice(),
+        ]
+        .concat()
+    }
+    struct Partial(VecDeque<Option<Vec<u8>>>);
+    impl Read for Partial {
+        fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+            match self.0.pop_front() {
+                None => Ok(0),
+                Some(None) => Err(io::ErrorKind::WouldBlock.into()),
+                Some(Some(mut data)) => {
+                    let n = bytes.len().min(data.len());
+                    bytes[..n].copy_from_slice(&data[..n]);
+                    data.drain(..n);
+                    if !data.is_empty() {
+                        self.0.push_front(Some(data));
+                    }
+                    Ok(n)
+                }
+            }
+        }
+    }
+    #[test]
+    fn partial_commands_keep_sequence_and_do_not_read_ahead() {
+        let data = packet(1, 2, 272, 1, 0);
+        let mut source = Partial(
+            [
+                Some(data[..7].to_vec()),
+                None,
+                Some([data[7..].to_vec(), packet(2, 0, 0, 0, 0)].concat()),
+            ]
+            .into(),
+        );
+        let mut r = Reader::default();
+        assert_eq!(r.next(&mut source).unwrap(), None);
+        assert_eq!(
+            r.next(&mut source).unwrap(),
+            Some((
+                1,
+                Command::Button {
+                    code: 272,
+                    pressed: true
+                }
+            ))
+        );
+        assert_eq!(r.next(&mut source).unwrap(), Some((2, Command::Barrier)));
+        assert_eq!(
+            r.next(&mut source).unwrap_err().kind(),
+            io::ErrorKind::UnexpectedEof
+        );
+    }
+    #[test]
+    fn absolute_commands_keep_stream_identity_and_reject_invalid_coordinates() {
+        let data = packet(1, 5, 123.5f64.to_bits(), 456.25f64.to_bits(), u64::MAX);
+        assert_eq!(
+            Reader::default().next(&mut data.as_slice()).unwrap(),
+            Some((
+                1,
+                Command::Absolute {
+                    x: 123.5,
+                    y: 456.25,
+                    stream: u64::MAX
+                }
+            ))
+        );
+        for (x, y, stream) in [
+            (0., 0., 0),
+            (-1., 1., 1),
+            (1., -1., 1),
+            (f64::NAN, 1., 1),
+            (1., f64::INFINITY, 1),
+            (1_000_001., 1., 1),
+        ] {
+            let data = packet(1, 5, x.to_bits(), y.to_bits(), stream);
+            assert_eq!(
+                Reader::default()
+                    .next(&mut data.as_slice())
+                    .unwrap_err()
+                    .kind(),
+                io::ErrorKind::InvalidData
+            );
+        }
+    }
+    #[test]
+    fn nonfinite_excessive_reserved_and_unselected_payloads_fail() {
+        for data in [
+            packet(0, 0, 0, 0, 0),
+            packet(2, 0, 0, 0, 0),
+            packet(1, 0, 1, 0, 0),
+            packet(1, 99, 0, 0, 0),
+            packet(1, 1, f64::NAN.to_bits(), 0, 0),
+            packet(1, 1, f64::INFINITY.to_bits(), 0, 0),
+            packet(1, 1, (-1_000_001f64).to_bits(), 0, 0),
+            packet(1, 1, 0, 0, 1),
+            packet(1, 2, 0, 1, 0),
+            packet(1, 2, 0x10000, 1, 0),
+            packet(1, 2, 272, 2, 0),
+            packet(1, 2, 272, 1, 1),
+            packet(1, 3, 0, 0, 0),
+            packet(1, 3, 0, 0, 4),
+            packet(1, 3, 0, 1f64.to_bits(), 1),
+            packet(1, 3, 0, 0, 8),
+            packet(1, 4, 0, 3841, 2),
+            packet(1, 4, 0, 0, 2),
+            packet(1, 4, u64::MAX, 120, 2),
+            packet(1, 4, 0, 120, 6),
+            vec![0; 31],
+        ] {
+            assert!(Reader::default().next(&mut &data[..]).is_err(), "{data:?}");
+        }
+    }
+    #[test]
+    fn valid_payloads_preserve_axis_selection_sign_and_stop() {
+        for (kind, a, b, c, expected) in [
+            (
+                1,
+                1.5f64.to_bits(),
+                (-2f64).to_bits(),
+                0,
+                Command::Relative { x: 1.5, y: -2. },
+            ),
+            (
+                2,
+                0xffff,
+                0,
+                0,
+                Command::Button {
+                    code: 0xffff,
+                    pressed: false,
+                },
+            ),
+            (
+                3,
+                0,
+                0,
+                6,
+                Command::Scroll {
+                    x: None,
+                    y: Some(0.),
+                    finger: true,
+                },
+            ),
+            (
+                3,
+                2f64.to_bits(),
+                0,
+                1,
+                Command::Scroll {
+                    x: Some(2.),
+                    y: None,
+                    finger: false,
+                },
+            ),
+            (
+                4,
+                (-120i64) as u64,
+                240,
+                3,
+                Command::Wheel {
+                    x: Some(-120),
+                    y: Some(240),
+                },
+            ),
+        ] {
+            assert_eq!(
+                Reader::default()
+                    .next(&mut &packet(1, kind, a, b, c)[..])
+                    .unwrap(),
+                Some((1, expected))
+            );
+        }
+    }
+    #[test]
+    fn sequences_cannot_repeat_skip_or_wrap() {
+        let data = [packet(1, 0, 0, 0, 0), packet(1, 0, 0, 0, 0)].concat();
+        let mut source = &data[..];
+        let mut r = Reader::default();
+        assert!(r.next(&mut source).is_ok());
+        assert!(r.next(&mut source).is_err());
+        let mut r = Reader {
+            sequence: u32::MAX,
+            ..Default::default()
+        };
+        assert!(r.next(&mut &packet(0, 0, 0, 0, 0)[..]).is_err());
+    }
+    #[test]
+    fn held_limit_duplicates_and_unpaired_release_fail_before_dispatch() {
+        let mut buttons = Buttons::default();
+        assert!(buttons.transition(272, false).is_err());
+        buttons.transition(272, true).unwrap();
+        assert!(buttons.transition(272, true).is_err());
+        buttons.transition(272, false).unwrap();
+        for code in 1..=MAX_BUTTONS as u32 {
+            buttons.transition(code, true).unwrap();
+        }
+        assert!(buttons.transition(100, true).is_err());
+        assert_eq!(buttons.0.len(), MAX_BUTTONS);
+        buttons.transition(1, false).unwrap();
+        buttons.transition(100, true).unwrap();
+    }
+    #[test]
+    fn replies_have_only_the_acknowledged_sequence() {
+        assert_eq!(
+            feedback(9).to_vec(),
+            [9u32, 0, 0, 0]
+                .into_iter()
+                .flat_map(u32::to_le_bytes)
+                .collect::<Vec<_>>()
+        );
+    }
+}
