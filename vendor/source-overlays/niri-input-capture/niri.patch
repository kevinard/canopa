+//! Private compositor capture lease. Consent and EI translation belong to the
+//! portal; this FD is a control capability and must never be handed to an app.
+//! Capture version 1 diverts pointer motion/buttons/axis only. It does not claim
+//! keyboard/touch capture or implement the public InputCapture interface.
+use std::cell::{Cell, RefCell};
+use std::io::{self, Read, Write};
+use std::net::Shutdown;
+use std::os::fd::OwnedFd;
+use std::os::unix::net::UnixStream;
+use std::rc::{Rc, Weak};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+
+use calloop::generic::Generic;
+use calloop::{Interest, Mode, PostAction};
+use serde::{Deserialize, Serialize};
+use zbus::{fdo, interface, zvariant};
+
+use super::Start;
+use crate::niri::{PointerVisibility, State};
+
+mod geometry;
+use geometry::{Barrier, Space, Zone};
+
+const MAX_LEASES: usize = 8;
+const MAX_MESSAGE: usize = 16 * 1024;
+type Zones = Vec<(u32, u32, i32, i32)>;
+type Reply = async_channel::Sender<fdo::Result<(u32, Zones)>>;
+
+pub struct InputCapture {
+    to_niri: calloop::channel::SyncSender<Open>,
+    admission: Arc<AtomicUsize>,
+}
+pub struct Permit(Arc<AtomicUsize>);
+impl Drop for Permit {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+pub struct Open {
+    stream: UnixStream,
+    permit: Permit,
+    reply: Reply,
+}
+impl InputCapture {
+    pub fn new(to_niri: calloop::channel::SyncSender<Open>) -> Self {
+        Self {
+            to_niri,
+            admission: Arc::new(AtomicUsize::new(0)),
+        }
+    }
+}
+#[interface(name = "org.canopa.Niri.InputCapture1")]
+impl InputCapture {
+    async fn open_pointer(&self) -> fdo::Result<(zvariant::OwnedFd, u32, Zones)> {
+        self.admission
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+                (n < MAX_LEASES).then_some(n + 1)
+            })
+            .map_err(|_| fdo::Error::LimitsExceeded("too many capture leases".into()))?;
+        let permit = Permit(self.admission.clone());
+        let (client, stream) = UnixStream::pair().map_err(|e| fdo::Error::Failed(e.to_string()))?;
+        stream
+            .set_nonblocking(true)
+            .map_err(|e| fdo::Error::Failed(e.to_string()))?;
+        let (reply, receive) = async_channel::bounded(1);
+        self.to_niri
+            .try_send(Open {
+                stream,
+                permit,
+                reply,
+            })
+            .map_err(|_| fdo::Error::LimitsExceeded("capture admission unavailable".into()))?;
+        let (generation, zones) = receive
+            .recv()
+            .await
+            .map_err(|_| fdo::Error::Failed("compositor stopped".into()))??;
+        Ok((
+            zvariant::OwnedFd::from(OwnedFd::from(client)),
+            generation,
+            zones,
+        ))
+    }
+    #[zbus(property)]
+    fn version(&self) -> u32 {
+        1
+    }
+    #[zbus(property)]
+    fn supported_capabilities(&self) -> u32 {
+        2
+    }
+}
+impl Start for InputCapture {
+    fn start(self, _monitor: bool) -> anyhow::Result<zbus::blocking::Connection> {
+        Ok(zbus::blocking::connection::Builder::session()?
+            .name("org.canopa.Niri.InputCapture1")?
+            .serve_at("/org/canopa/Niri/InputCapture1", self)?
+            .build()?)
+    }
+}
+
+#[derive(Default, Clone)]
+pub struct Leases {
+    entries: Rc<RefCell<Vec<Weak<RefCell<Lease>>>>>,
+    hidden: Rc<Cell<bool>>,
+}
+impl Leases {
+    fn live(&self) -> Vec<Rc<RefCell<Lease>>> {
+        let mut entries = self.entries.borrow_mut();
+        entries.retain(|entry| entry.strong_count() != 0);
+        entries.iter().filter_map(Weak::upgrade).collect()
+    }
+    fn active(&self) -> Option<Rc<RefCell<Lease>>> {
+        self.live()
+            .into_iter()
+            .find(|lease| lease.borrow().active.is_some())
+    }
+    fn sync_cursor(&self, state: &mut State) {
+        if self.active().is_some() {
+            self.hidden.set(true);
+            if state.niri.pointer_visibility != PointerVisibility::Hidden {
+                state.niri.pointer_visibility = PointerVisibility::Hidden;
+                state.niri.queue_redraw_all();
+            }
+        } else if self.hidden.replace(false) {
+            state.niri.pointer_visibility = PointerVisibility::Visible;
+            state.niri.queue_redraw_all();
+        }
+    }
+}
+fn leases(state: &State) -> Option<Leases> {
+    state
+        .niri
+        .dbus
+        .as_ref()
+        .map(|dbus| dbus.input_capture_leases.clone())
+}
+fn zones(state: &State) -> Vec<Zone> {
+    state
+        .niri
+        .global_space
+        .outputs()
+        .filter_map(|output| {
+            let rect = state.niri.global_space.output_geometry(output)?;
+            Some(Zone {
+                width: rect.size.w.try_into().unwrap_or(0),
+                height: rect.size.h.try_into().unwrap_or(0),
+                x: rect.loc.x,
+                y: rect.loc.y,
+            })
+        })
+        .collect()
+}
+fn describe(space: &Space) -> Zones {
+    space
+        .zones()
+        .iter()
+        .map(|z| (z.width, z.height, z.x, z.y))
+        .collect()
+}
+fn unavailable(state: &State) -> bool {
+    state.niri.is_locked()
+        || state.niri.screenshot_ui.is_open()
+        || state.niri.exit_confirm_dialog.is_open()
+}
+
+/// Messages have a little-endian u32 byte count followed by bounded JSON.
+/// A partial/oversized/malformed request or failed event write retires the lease.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    sequence: u64,
+    command: Command,
+}
+#[derive(Deserialize)]
+#[serde(tag = "op", rename_all = "snake_case", deny_unknown_fields)]
+enum Command {
+    GetZones,
+    SetBarriers {
+        zone_set: u32,
+        barriers: Vec<(u32, (i32, i32, i32, i32))>,
+    },
+    Enable,
+    Disable,
+    Release {
+        activation: u32,
+    },
+}
+#[derive(Serialize)]
+#[serde(tag = "event", rename_all = "snake_case")]
+enum Event {
+    Reply {
+        sequence: u64,
+        error: Option<&'static str>,
+        failed_barriers: Vec<u32>,
+    },
+    Zones {
+        sequence: u64,
+        zone_set: u32,
+        zones: Zones,
+    },
+    ZonesChanged {
+        zone_set: u32,
+    },
+    Activated {
+        activation: u32,
+        barrier: u32,
+        position: (f64, f64),
+    },
+    Deactivated {
+        activation: u32,
+    },
+    Disabled,
+    Motion {
+        time: u64,
+        delta: (f64, f64),
+    },
+    Button {
+        time: u64,
+        button: u32,
+        pressed: bool,
+    },
+    Axis {
+        time: u64,
+        source: u32,
+        amount: (Option<f64>, Option<f64>),
+        v120: (Option<f64>, Option<f64>),
+    },
+}
+#[derive(Default)]
+struct Reader {
+    header: [u8; 4],
+    header_bytes: usize,
+    payload: Vec<u8>,
+    payload_bytes: usize,
+}
+impl Reader {
+    fn next(&mut self, stream: &mut impl Read) -> io::Result<Option<Request>> {
+        loop {
+            let target = if self.header_bytes < 4 {
+                &mut self.header[self.header_bytes..]
+            } else {
+                &mut self.payload[self.payload_bytes..]
+            };
+            match stream.read(target) {
+                Ok(0) => return Err(io::ErrorKind::UnexpectedEof.into()),
+                Ok(n) => {
+                    if self.header_bytes < 4 {
+                        self.header_bytes += n;
+                        if self.header_bytes == 4 {
+                            let len = u32::from_le_bytes(self.header) as usize;
+                            if len == 0 || len > MAX_MESSAGE {
+                                return Err(io::ErrorKind::InvalidData.into());
+                            }
+                            self.payload.resize(len, 0);
+                        }
+                    } else {
+                        self.payload_bytes += n;
+                        if self.payload_bytes == self.payload.len() {
+                            let value = serde_json::from_slice(&self.payload)
+                                .map_err(|_| io::Error::from(io::ErrorKind::InvalidData))?;
+                            self.header_bytes = 0;
+                            self.payload_bytes = 0;
+                            self.payload.clear();
+                            return Ok(Some(value));
+                        }
+                    }
+                }
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => return Ok(None),
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+                Err(error) => return Err(error),
+            }
+        }
+    }
+}
+struct Lease {
+    _permit: Permit,
+    reader: Reader,
+    writer: UnixStream,
+    space: Space,
+    enabled: bool,
+    active: Option<u32>,
+    activation: u32,
+    position: (f64, f64),
+    sequence: u64,
+    retired: bool,
+}
+impl Drop for Lease {
+    fn drop(&mut self) {
+        self.retire();
+    }
+}
+impl Lease {
+    fn retire(&mut self) {
+        self.enabled = false;
+        self.active = None;
+        self.retired = true;
+        let _ = self.writer.shutdown(Shutdown::Both);
+    }
+    fn feedback(&mut self, event: Event) -> bool {
+        if self.retired {
+            return false;
+        }
+        let result = (|| -> io::Result<()> {
+            let payload = serde_json::to_vec(&event)?;
+            if payload.len() > MAX_MESSAGE {
+                return Err(io::ErrorKind::InvalidData.into());
+            }
+            let mut packet = Vec::with_capacity(4 + payload.len());
+            packet.extend_from_slice(&(payload.len() as u32).to_le_bytes());
+            packet.extend_from_slice(&payload);
+            self.writer.write_all(&packet)
+        })();
+        if result.is_err() {
+            self.retire();
+            false
+        } else {
+            true
+        }
+    }
+    fn deactivate(&mut self) {
+        if let Some(activation) = self.active.take() {
+            self.feedback(Event::Deactivated { activation });
+        }
+    }
+    fn disable(&mut self) {
+        self.deactivate();
+        if std::mem::take(&mut self.enabled) {
+            self.feedback(Event::Disabled);
+        }
+    }
+    fn command(&mut self, request: Request, busy: bool, available: bool) {
+        if request.sequence == 0 || request.sequence <= self.sequence {
+            self.retire();
+            return;
+        }
+        self.sequence = request.sequence;
+        let mut error = None;
+        let mut failed_barriers = Vec::new();
+        match request.command {
+            Command::GetZones => {
+                self.feedback(Event::Zones {
+                    sequence: request.sequence,
+                    zone_set: self.space.generation(),
+                    zones: describe(&self.space),
+                });
+                return;
+            }
+            Command::SetBarriers { zone_set, barriers } => {
+                let barriers: Vec<_> = barriers
+                    .into_iter()
+                    .map(|(id, position)| Barrier { id, position })
+                    .collect();
+                match self.space.replace(zone_set, &barriers) {
+                    Ok(failed) => {
+                        self.disable();
+                        failed_barriers = failed;
+                    }
+                    Err(_) => error = Some("invalid_barriers_or_zone_set"),
+                }
+            }
+            Command::Enable => {
+                if !available {
+                    error = Some("unavailable");
+                } else if busy {
+                    error = Some("busy");
+                } else {
+                    self.enabled = true;
+                }
+            }
+            Command::Disable => self.disable(),
+            Command::Release { activation } => {
+                if self.active != Some(activation) {
+                    error = Some("stale_activation");
+                } else {
+                    self.deactivate();
+                }
+            }
+        }
+        self.feedback(Event::Reply {
+            sequence: request.sequence,
+            error,
+            failed_barriers,
+        });
+    }
+}
+
+pub fn open(state: &mut State, message: Open, entries: &Leases) {
+    if unavailable(state) {
+        let _ = message
+            .reply
+            .try_send(Err(fdo::Error::AccessDenied("capture unavailable".into())));
+        return;
+    }
+    let space = match Space::new(zones(state)) {
+        Ok(space) => space,
+        Err(_) => {
+            let _ = message
+                .reply
+                .try_send(Err(fdo::Error::LimitsExceeded("invalid zones".into())));
+            return;
+        }
+    };
+    let initial = (space.generation(), describe(&space));
+    let writer = match message.stream.try_clone() {
+        Ok(writer) => writer,
+        Err(error) => {
+            let _ = message
+                .reply
+                .try_send(Err(fdo::Error::Failed(error.to_string())));
+            return;
+        }
+    };
+    let lease = Rc::new(RefCell::new(Lease {
+        _permit: message.permit,
+        reader: Reader::default(),
+        writer,
+        space,
+        enabled: false,
+        active: None,
+        activation: 0,
+        position: (0., 0.),
+        sequence: 0,
+        retired: false,
+    }));
+    entries.entries.borrow_mut().push(Rc::downgrade(&lease));
+    let registry = entries.clone();
+    let result = state.niri.event_loop.insert_source(
+        Generic::new(message.stream, Interest::READ, Mode::Level),
+        move |_, socket, state| {
+            refresh(state);
+            for _ in 0..8 {
+                if lease.borrow().retired {
+                    registry.sync_cursor(state);
+                    return Ok(PostAction::Remove);
+                }
+                let reading = { lease.borrow_mut().reader.next(&mut &**socket) };
+                let request = match reading {
+                    Ok(Some(request)) => request,
+                    Ok(None) => {
+                        registry.sync_cursor(state);
+                        return Ok(PostAction::Continue);
+                    }
+                    Err(_) => {
+                        lease.borrow_mut().retire();
+                        registry.sync_cursor(state);
+                        return Ok(PostAction::Remove);
+                    }
+                };
+                let busy = registry
+                    .live()
+                    .iter()
+                    .any(|other| !Rc::ptr_eq(other, &lease) && other.borrow().enabled);
+                lease
+                    .borrow_mut()
+                    .command(request, busy, !unavailable(state));
+            }
+            registry.sync_cursor(state);
+            Ok(PostAction::Continue)
+        },
+    );
+    let _ = message.reply.try_send(
+        result
+            .map(|_| initial)
+            .map_err(|error| fdo::Error::Failed(error.to_string())),
+    );
+}
+
+pub fn refresh(state: &mut State) {
+    let Some(registry) = leases(state) else {
+        return;
+    };
+    let zones = zones(state);
+    for lease in registry.live() {
+        let mut lease = lease.borrow_mut();
+        if lease.retired {
+            continue;
+        }
+        if unavailable(state) {
+            lease.disable();
+        }
+        match lease.space.refresh(zones.clone()) {
+            Ok(Some(zone_set)) => {
+                lease.disable();
+                lease.feedback(Event::ZonesChanged { zone_set });
+            }
+            Ok(None) => {}
+            Err(_) => lease.retire(),
+        }
+    }
+    registry.sync_cursor(state);
+}
+pub fn disable(state: &mut State) -> bool {
+    let Some(registry) = leases(state) else {
+        return false;
+    };
+    let mut changed = false;
+    for lease in registry.live() {
+        let mut lease = lease.borrow_mut();
+        changed |= lease.enabled;
+        lease.disable();
+    }
+    registry.sync_cursor(state);
+    changed
+}
+/// Absolute events carry their unconfined global position; relative events carry
+/// a delta. The barrier-triggering motion is described by Activated.position;
+/// subsequent motions are emitted once, with no ordinary local delivery.
+pub fn motion(
+    state: &mut State,
+    from: (f64, f64),
+    value: (f64, f64),
+    absolute: bool,
+    time: u64,
+    eligible: bool,
+) -> bool {
+    refresh(state);
+    let Some(registry) = leases(state) else {
+        return false;
+    };
+    if !eligible {
+        disable(state);
+        return false;
+    }
+    let Some(lease) = registry
+        .live()
+        .into_iter()
+        .find(|lease| lease.borrow().enabled)
+    else {
+        return false;
+    };
+    let mut lease = lease.borrow_mut();
+    let to = if absolute {
+        value
+    } else {
+        (from.0 + value.0, from.1 + value.1)
+    };
+    if ![to.0, to.1, value.0, value.1]
+        .into_iter()
+        .all(f64::is_finite)
+    {
+        lease.retire();
+        drop(lease);
+        registry.sync_cursor(state);
+        return false;
+    }
+    let consumed = if lease.active.is_some() {
+        let delta = if absolute {
+            (value.0 - lease.position.0, value.1 - lease.position.1)
+        } else {
+            value
+        };
+        lease.position = if absolute {
+            value
+        } else {
+            (lease.position.0 + value.0, lease.position.1 + value.1)
+        };
+        if [delta.0, delta.1, lease.position.0, lease.position.1]
+            .into_iter()
+            .all(f64::is_finite)
+        {
+            lease.feedback(Event::Motion { time, delta })
+        } else {
+            lease.retire();
+            false
+        }
+    } else if let Some(barrier) = lease
+        .space
+        .crossing(from, to)
+        .filter(|_| state.niri.suppressed_buttons.is_empty())
+    {
+        lease.activation = lease.activation.wrapping_add(1).max(1);
+        let activation = lease.activation;
+        lease.active = Some(activation);
+        lease.position = to;
+        lease.feedback(Event::Activated {
+            activation,
+            barrier,
+            position: to,
+        })
+    } else {
+        false
+    };
+    drop(lease);
+    registry.sync_cursor(state);
+    consumed
+}
+pub fn button(state: &mut State, button: u32, pressed: bool, time: u64) -> bool {
+    refresh(state);
+    let Some(registry) = leases(state) else {
+        return false;
+    };
+    let Some(lease) = registry.active() else {
+        return false;
+    };
+    let consumed = lease.borrow_mut().feedback(Event::Button {
+        time,
+        button,
+        pressed,
+    });
+    registry.sync_cursor(state);
+    consumed
+}
+pub fn axis(
+    state: &mut State,
+    time: u64,
+    source: u32,
+    amount: (Option<f64>, Option<f64>),
+    v120: (Option<f64>, Option<f64>),
+) -> bool {
+    refresh(state);
+    let Some(registry) = leases(state) else {
+        return false;
+    };
+    let Some(lease) = registry.active() else {
+        return false;
+    };
+    let mut lease = lease.borrow_mut();
+    let consumed = if [amount.0, amount.1, v120.0, v120.1]
+        .into_iter()
+        .flatten()
+        .all(f64::is_finite)
+    {
+        lease.feedback(Event::Axis {
+            time,
+            source,
+            amount,
+            v120,
+        })
+    } else {
+        lease.retire();
+        false
+    };
+    drop(lease);
+    registry.sync_cursor(state);
+    consumed
+}
diff --git a/src/dbus/input_capture/geometry.rs b/src/dbus/input_capture/geometry.rs
--- /dev/null
+++ b/src/dbus/input_capture/geometry.rs
@@ -0,0 +1,364 @@
+//! Logical portal zones and outside-edge barriers. Pixel spans are inclusive;
+//! crossing uses the unconfined destination, before normal pointer clipping.
+use std::collections::{BTreeMap, BTreeSet};
+
+pub const MAX_ZONES: usize = 64;
+pub const MAX_BARRIERS: usize = 128;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub struct Zone {
+    pub width: u32,
+    pub height: u32,
+    pub x: i32,
+    pub y: i32,
+}
+impl Zone {
+    fn bounds(self) -> [i64; 4] {
+        [
+            self.x.into(),
+            self.y.into(),
+            i64::from(self.x) + i64::from(self.width),
+            i64::from(self.y) + i64::from(self.height),
+        ]
+    }
+    fn contains(self, p: (f64, f64)) -> bool {
+        let [x, y, right, bottom] = self.bounds();
+        x as f64 <= p.0 && p.0 < right as f64 && y as f64 <= p.1 && p.1 < bottom as f64
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct Barrier {
+    pub id: u32,
+    pub position: (i32, i32, i32, i32),
+}
+#[derive(Clone, Copy, Debug)]
+struct Edge {
+    id: u32,
+    vertical: bool,
+    coordinate: i64,
+    start: i64,
+    end: i64,
+    positive: bool,
+}
+impl Edge {
+    fn candidates(barrier: Barrier, zone: Zone) -> Vec<Self> {
+        let (x1, y1, x2, y2) = barrier.position;
+        let [left, top, right, bottom] = zone.bounds();
+        let mut edges = Vec::with_capacity(2);
+        if x1 == x2 {
+            let coordinate = i64::from(x1);
+            let start = i64::from(y1.min(y2));
+            let end = i64::from(y1.max(y2));
+            if top <= start && end < bottom && (coordinate == left || coordinate == right) {
+                edges.push(Self {
+                    id: barrier.id,
+                    vertical: true,
+                    coordinate,
+                    start,
+                    end,
+                    positive: coordinate == right,
+                });
+            }
+        }
+        if y1 == y2 {
+            let coordinate = i64::from(y1);
+            let start = i64::from(x1.min(x2));
+            let end = i64::from(x1.max(x2));
+            if left <= start && end < right && (coordinate == top || coordinate == bottom) {
+                edges.push(Self {
+                    id: barrier.id,
+                    vertical: false,
+                    coordinate,
+                    start,
+                    end,
+                    positive: coordinate == bottom,
+                });
+            }
+        }
+        edges
+    }
+    fn outside(self, zones: &[Zone]) -> bool {
+        zones.iter().all(|zone| {
+            let [x, y, right, bottom] = zone.bounds();
+            let (low, high, start, end) = if self.vertical {
+                (x, right, y, bottom)
+            } else {
+                (y, bottom, x, right)
+            };
+            let covered = if self.positive {
+                low <= self.coordinate && self.coordinate < high
+            } else {
+                low < self.coordinate && self.coordinate <= high
+            };
+            // A touching zone endpoint does not cover the next inclusive pixel.
+            !covered || end <= self.start || self.end < start
+        })
+    }
+    fn crossing(self, from: (f64, f64), to: (f64, f64)) -> Option<f64> {
+        let (old, new, tangent_old, tangent_new) = if self.vertical {
+            (from.0, to.0, from.1, to.1)
+        } else {
+            (from.1, to.1, from.0, to.0)
+        };
+        let boundary = self.coordinate as f64;
+        // Left/top boundary pixels remain inside their zone. Right/bottom
+        // boundaries already lie outside the half-open logical rectangle.
+        let crosses = if self.positive {
+            old < boundary && new >= boundary
+        } else {
+            old >= boundary && new < boundary
+        };
+        if !crosses {
+            return None;
+        }
+        let t = (boundary - old) / (new - old);
+        let tangent = tangent_old + t * (tangent_new - tangent_old);
+        (self.start as f64 <= tangent && tangent < (self.end + 1) as f64).then_some(t)
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum Error {
+    InvalidZones,
+    TooManyBarriers,
+    StaleZoneSet,
+}
+
+pub struct Space {
+    zones: Vec<Zone>,
+    generation: u32,
+    edges: Vec<Edge>,
+}
+impl Space {
+    pub fn new(zones: Vec<Zone>) -> Result<Self, Error> {
+        Ok(Self {
+            zones: Self::normalize(zones)?,
+            generation: 1,
+            edges: Vec::new(),
+        })
+    }
+    fn normalize(mut zones: Vec<Zone>) -> Result<Vec<Zone>, Error> {
+        if zones.len() > MAX_ZONES || zones.iter().any(|z| z.width == 0 || z.height == 0) {
+            return Err(Error::InvalidZones);
+        }
+        zones.sort_unstable();
+        zones.dedup();
+        Ok(zones)
+    }
+    pub fn zones(&self) -> &[Zone] {
+        &self.zones
+    }
+    pub fn generation(&self) -> u32 {
+        self.generation
+    }
+    /// Returns the invalidated generation. Topology changes erase all barriers.
+    pub fn refresh(&mut self, zones: Vec<Zone>) -> Result<Option<u32>, Error> {
+        let zones = Self::normalize(zones)?;
+        if zones == self.zones {
+            return Ok(None);
+        }
+        let previous = self.generation;
+        self.generation = self.generation.wrapping_add(1);
+        self.zones = zones;
+        self.edges.clear();
+        Ok(Some(previous))
+    }
+    pub fn replace(&mut self, generation: u32, barriers: &[Barrier]) -> Result<Vec<u32>, Error> {
+        if generation != self.generation {
+            return Err(Error::StaleZoneSet);
+        }
+        if barriers.len() > MAX_BARRIERS {
+            return Err(Error::TooManyBarriers);
+        }
+        let mut counts = BTreeMap::<u32, usize>::new();
+        for barrier in barriers {
+            *counts.entry(barrier.id).or_default() += 1;
+        }
+        let mut edges = Vec::new();
+        let mut failed = BTreeSet::new();
+        for barrier in barriers {
+            let edge = (barrier.id != 0 && counts[&barrier.id] == 1)
+                .then(|| {
+                    self.zones
+                        .iter()
+                        .flat_map(|zone| Edge::candidates(*barrier, *zone))
+                        .find(|edge| edge.outside(&self.zones))
+                })
+                .flatten();
+            if let Some(edge) = edge {
+                edges.push(edge);
+            } else {
+                failed.insert(barrier.id);
+            }
+        }
+        self.edges = edges;
+        Ok(failed.into_iter().collect())
+    }
+    pub fn crossing(&self, from: (f64, f64), to: (f64, f64)) -> Option<u32> {
+        if ![from.0, from.1, to.0, to.1].into_iter().all(f64::is_finite)
+            || !self.zones.iter().any(|zone| zone.contains(from))
+        {
+            return None;
+        }
+        self.edges
+            .iter()
+            .filter_map(|edge| edge.crossing(from, to).map(|t| (t, edge.id)))
+            .min_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)))
+            .map(|(_, id)| id)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn zone(x: i32, y: i32, width: u32, height: u32) -> Zone {
+        Zone {
+            x,
+            y,
+            width,
+            height,
+        }
+    }
+    fn barrier(id: u32, position: (i32, i32, i32, i32)) -> Barrier {
+        Barrier { id, position }
+    }
+    #[test]
+    fn adjacent_outputs_have_no_internal_barrier() {
+        let mut s = Space::new(vec![zone(0, 0, 1920, 1080), zone(1920, 0, 1920, 1080)]).unwrap();
+        let positions = [
+            (0, 0, 1919, 0),
+            (0, 1080, 1919, 1080),
+            (1920, 0, 3839, 0),
+            (1920, 1080, 3839, 1080),
+            (0, 0, 0, 1079),
+            (3840, 0, 3840, 1079),
+            (1920, 0, 1920, 1079),
+            (0, 0, 3839, 0),
+        ];
+        let b: Vec<_> = positions
+            .into_iter()
+            .enumerate()
+            .map(|(i, p)| barrier(i as u32 + 1, p))
+            .collect();
+        assert_eq!(s.replace(1, &b).unwrap(), vec![7, 8]);
+        assert_eq!(s.crossing((1900., 500.), (1950., 500.)), None);
+        assert_eq!(s.crossing((3830., 500.), (3890., 500.)), Some(6));
+    }
+    #[test]
+    fn partial_neighbors_cover_only_their_shared_pixels() {
+        let mut s = Space::new(vec![zone(-100, -50, 100, 100), zone(0, -25, 50, 50)]).unwrap();
+        assert_eq!(
+            s.replace(
+                1,
+                &[
+                    barrier(1, (0, -50, 0, -26)),
+                    barrier(2, (0, 25, 0, 49)),
+                    barrier(3, (0, -26, 0, -25)),
+                    barrier(4, (0, 24, 0, 25))
+                ]
+            )
+            .unwrap(),
+            vec![3, 4]
+        );
+        assert_eq!(s.crossing((-1., -25.1), (3., -25.1)), Some(1));
+        assert_eq!(s.crossing((-1., -25.), (3., -25.)), None);
+    }
+    #[test]
+    fn one_pixel_spans_are_inclusive_and_allow_reversed_endpoints() {
+        let mut s = Space::new(vec![zone(0, 0, 10, 10)]).unwrap();
+        assert!(s
+            .replace(
+                1,
+                &[
+                    barrier(1, (10, 8, 10, 9)),
+                    barrier(2, (0, 2, 0, 2)),
+                    barrier(3, (5, 10, 3, 10))
+                ]
+            )
+            .unwrap()
+            .is_empty());
+        assert_eq!(s.crossing((9., 9.9), (12., 9.9)), Some(1));
+        assert_eq!(s.crossing((1., 2.9), (-2., 2.9)), Some(2));
+        assert_eq!(s.crossing((1., 3.), (-2., 3.)), None);
+        assert_eq!(s.crossing((5.9, 9.), (5.9, 12.)), Some(3));
+    }
+    #[test]
+    fn invalid_and_duplicate_ids_fail_without_discarding_valid_barriers() {
+        let mut s = Space::new(vec![zone(0, 0, 10, 10)]).unwrap();
+        assert_eq!(
+            s.replace(
+                1,
+                &[
+                    barrier(0, (0, 0, 0, 9)),
+                    barrier(2, (10, 0, 10, 9)),
+                    barrier(2, (0, 0, 0, 9)),
+                    barrier(3, (0, 0, 9, 9)),
+                    barrier(4, (5, 0, 5, 9)),
+                    barrier(5, (0, 0, 9, 0))
+                ]
+            )
+            .unwrap(),
+            vec![0, 2, 3, 4]
+        );
+        assert_eq!(s.crossing((5., 1.), (5., -20.)), Some(5));
+        assert_eq!(s.crossing((9., 1.), (30., 1.)), None);
+    }
+    #[test]
+    fn crossing_uses_the_full_motion_before_clipping_and_chooses_first_edge() {
+        let mut s = Space::new(vec![zone(0, 0, 10, 10)]).unwrap();
+        s.replace(1, &[barrier(9, (10, 0, 10, 9)), barrier(1, (0, 10, 9, 10))])
+            .unwrap();
+        assert_eq!(s.crossing((8., 8.), (18., 12.)), Some(9));
+        assert_eq!(s.crossing((8., 8.), (12., 18.)), Some(1));
+        assert_eq!(s.crossing((8., 8.), (10., 10.)), None); // exclusive tangent ends
+        assert_eq!(s.crossing((8., 8.), (9., 9.)), None); // clipped point never crosses
+        assert_eq!(s.crossing((8., 8.), (f64::INFINITY, 8.)), None);
+    }
+    #[test]
+    fn topology_invalidates_only_when_geometry_changes_and_wraps() {
+        let a = zone(-10, 0, 10, 10);
+        let b = zone(10, 0, 10, 10);
+        let mut s = Space::new(vec![a, b]).unwrap();
+        s.replace(1, &[barrier(1, (-10, 0, -10, 9))]).unwrap();
+        assert_eq!(s.refresh(vec![b, a, a]).unwrap(), None);
+        assert_eq!(s.replace(9, &[]), Err(Error::StaleZoneSet));
+        assert_eq!(s.crossing((-9., 2.), (-20., 2.)), Some(1));
+        s.generation = u32::MAX;
+        assert_eq!(s.refresh(vec![a]).unwrap(), Some(u32::MAX));
+        assert_eq!(s.generation(), 0);
+        assert_eq!(s.crossing((-9., 2.), (-20., 2.)), None);
+        assert_eq!(s.replace(u32::MAX, &[]), Err(Error::StaleZoneSet));
+        assert_eq!(s.refresh(Vec::new()).unwrap(), Some(0));
+    }
+    #[test]
+    fn limits_do_not_mutate_the_previous_valid_configuration() {
+        assert!(matches!(
+            Space::new(vec![zone(0, 0, 0, 1)]),
+            Err(Error::InvalidZones)
+        ));
+        assert!(matches!(
+            Space::new(vec![zone(0, 0, 1, 1); MAX_ZONES + 1]),
+            Err(Error::InvalidZones)
+        ));
+        let mut s = Space::new(vec![zone(i32::MAX - 2, i32::MIN, 2, 2)]).unwrap();
+        s.replace(
+            1,
+            &[barrier(1, (i32::MAX, i32::MIN, i32::MAX, i32::MIN + 1))],
+        )
+        .unwrap();
+        assert_eq!(
+            s.replace(1, &vec![barrier(2, (0, 0, 0, 0)); MAX_BARRIERS + 1]),
+            Err(Error::TooManyBarriers)
+        );
+        assert!(s.refresh(vec![zone(0, 0, 1, 0)]).is_err());
+        assert_eq!(
+            s.crossing(
+                (f64::from(i32::MAX) - 1., f64::from(i32::MIN) + 1.5),
+                (f64::from(i32::MAX) + 10., f64::from(i32::MIN) + 1.5)
+            ),
+            Some(1)
+        );
+        assert_eq!(s.zones().len(), 1);
+    }
+}
