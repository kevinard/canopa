+    }
+    #[test]
+    fn source_limit_refuses_new_authority_without_forgetting_owned_release_tails() {
+        let mut k = Keyboard::default();
+        let owner = recipient(1, 1);
+        k.activate(owner).unwrap();
+        for source in 1..=MAX_SOURCES as u64 {
+            edge(&mut k, source, 30, true);
+        }
+        assert_eq!(
+            k.edge(MAX_SOURCES as u64 + 1, 30, true, true),
+            Err(Refusal::Exhausted)
+        );
+        assert_eq!(k.deactivate().unwrap().releases, vec![key(30, false)]);
+        for source in 1..=MAX_SOURCES as u64 {
+            let event = edge(&mut k, source, 30, false);
+            assert_eq!(event.route, Route::Intercept);
+            assert_eq!(event.captured, None);
+        }
+        assert_eq!(k.activate(recipient(2, 1)), Err(Refusal::Exhausted));
+        assert_eq!(k.edge(1, 31, true, false), Ok(Outcome::local()));
+    }
+    #[test]
+    fn press_limit_preserves_bounded_pairing_and_permanently_refuses_readmission() {
+        let mut k = Keyboard::default();
+        k.activate(recipient(1, 1)).unwrap();
+        let mut accepted = 0;
+        'fill: for source in 1..=MAX_SOURCES as u64 {
+            for code in 1..=MAX_KEY {
+                match k.edge(source, code, true, true) {
+                    Ok(_) => accepted += 1,
+                    Err(Refusal::Exhausted) => break 'fill,
+                    other => panic!("unexpected admission: {other:?}"),
+                }
+            }
+        }
+        assert_eq!(accepted, MAX_PRESSES);
+        assert_eq!(k.deactivate().unwrap().releases.len(), MAX_KEY as usize);
+        for source in 1..=MAX_SOURCES as u64 {
+            k.source_closed(source);
+        }
+        assert_eq!(k.activate(recipient(2, 1)), Err(Refusal::Exhausted));
+        assert!(k.local_keys().next().is_none());
+    }
+    #[test]
+    fn invalid_or_overlapping_activation_cannot_replace_the_current_recipient() {
+        let mut k = Keyboard::default();
+        assert_eq!(k.activate(recipient(0, 1)), Err(Refusal::Invalid));
+        assert_eq!(k.activate(recipient(1, 0)), Err(Refusal::Invalid));
+        let owner = recipient(1, 1);
+        k.activate(owner).unwrap();
+        assert_eq!(k.activate(recipient(2, 1)), Err(Refusal::Active));
+        assert_eq!(k.edge(0, 30, true, true), Err(Refusal::Invalid));
+        assert_eq!(k.edge(1, MAX_KEY + 1, true, true), Err(Refusal::Invalid));
+        assert_eq!(k.active(), Some(owner));
+        captured(edge(&mut k, 1, 30, true), owner, 30, true);
+    }
+    #[test]
+    fn interleaved_source_loss_and_capture_replacement_never_emit_an_unpaired_ei_edge() {
+        let mut k = Keyboard::default();
+        let mut seed = 0x8734_1928_u64;
+        let mut observed = BTreeSet::new();
+        let mut lease = 0;
+        let observe = |event: Outcome, observed: &mut BTreeSet<u32>, active: Option<Recipient>| {
+            if let Some((owner, key)) = event.captured {
+                assert_eq!(Some(owner), active);
+                if key.pressed {
+                    assert!(observed.insert(key.code));
+                } else {
+                    assert!(observed.remove(&key.code));
+                }
+            }
+        };
+        for _ in 0..20_000 {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            let source = 1 + ((seed >> 8) % 64);
+            let code = 1 + ((seed >> 16) % 32) as u32;
+            match seed % 12 {
+                0 if k.active().is_none() => {
+                    lease += 1;
+                    k.activate(recipient(lease, 1)).unwrap();
+                }
+                1 => {
+                    if let Some(retired) = k.deactivate() {
+                        for key in retired.releases {
+                            assert!(observed.remove(&key.code));
+                        }
+                        assert!(observed.is_empty());
+                    }
+                }
+                2 => {
+                    for event in k.source_closed(source) {
+                        observe(event, &mut observed, k.active());
+                    }
+                }
+                _ => {
+                    let active = k.active();
+                    observe(
+                        edge(&mut k, source, code, seed & 0x1000 != 0),
+                        &mut observed,
+                        active,
+                    );
+                }
+            }
+        }
+        if let Some(retired) = k.deactivate() {
+            for key in retired.releases {
+                assert!(observed.remove(&key.code));
+            }
+        }
+        assert!(observed.is_empty());
+    }
+}
diff --git a/src/dbus/input_capture/keys.rs b/src/dbus/input_capture/keys.rs
--- /dev/null
+++ b/src/dbus/input_capture/keys.rs
@@ -0,0 +1,123 @@
+//! Capture XKB is independent of the ordinary seat's pressed/modifier state.
+use smithay::input::keyboard::xkb;
+
+use super::keyboard::Key;
+use crate::niri::State as Niri;
+
+pub type Modifiers = super::masks::Modifiers;
+pub struct State {
+    state: xkb::State,
+    external: Modifiers,
+}
+fn external(niri: &Niri) -> Modifiers {
+    let m = niri
+        .niri
+        .seat
+        .get_keyboard()
+        .unwrap()
+        .modifier_state()
+        .serialized;
+    (m.depressed, m.latched, m.locked, m.layout_effective)
+}
+impl State {
+    pub fn new(niri: &mut Niri, local: impl Iterator<Item = u32>, virtual_local: u32) -> Self {
+        let keyboard = niri.niri.seat.get_keyboard().unwrap();
+        let map = keyboard.with_xkb_state(niri, |context| {
+            let xkb = context.xkb().lock().unwrap();
+            // SAFETY: only obtain an independently referenced keymap while the
+            // ordinary XKB guard lives. Never mutate the ordinary XKB state.
+            unsafe { xkb.state() }.get_keymap()
+        });
+        let mut result = Self {
+            state: xkb::State::new(&map),
+            external: external(niri),
+        };
+        for code in local {
+            result.update(Key {
+                code,
+                pressed: true,
+            });
+        }
+        let (depressed, _, _, _) = result.modifiers();
+        let (_, latched, locked, group) = result.external;
+        result
+            .state
+            .update_mask(depressed | virtual_local, latched, locked, 0, 0, group);
+        result
+    }
+    pub fn update(&mut self, key: Key) {
+        self.state.update_key(
+            xkb::Keycode::new(key.code + 8),
+            if key.pressed {
+                xkb::KeyDirection::Down
+            } else {
+                xkb::KeyDirection::Up
+            },
+        );
+    }
+    pub fn set_mask(&mut self, depressed: u32, latched: u32, locked: u32, group: u32) {
+        self.state
+            .update_mask(depressed, latched, locked, 0, 0, group);
+    }
+    pub fn expect_main(&mut self, masks: Modifiers) {
+        // The adapter will apply precisely these filtered ordinary masks. They
+        // are not an external change that should overwrite captured mask bits.
+        self.external = masks;
+    }
+    pub fn modifiers(&self) -> Modifiers {
+        (
+            self.state.serialize_mods(xkb::STATE_MODS_DEPRESSED),
+            self.state.serialize_mods(xkb::STATE_MODS_LATCHED),
+            self.state.serialize_mods(xkb::STATE_MODS_LOCKED),
+            self.state.serialize_layout(xkb::STATE_LAYOUT_EFFECTIVE),
+        )
+    }
+    pub fn pause_combo(&self) -> bool {
+        self.state
+            .mod_name_is_active(xkb::MOD_NAME_CTRL, xkb::STATE_MODS_EFFECTIVE)
+            && self
+                .state
+                .mod_name_is_active(xkb::MOD_NAME_ALT, xkb::STATE_MODS_EFFECTIVE)
+    }
+    pub fn sync_external(&mut self, niri: &Niri) -> bool {
+        let next = external(niri);
+        let before = self.modifiers();
+        if next.1 != self.external.1 || next.2 != self.external.2 || next.3 != self.external.3 {
+            self.state.update_mask(
+                before.0,
+                if next.1 != self.external.1 {
+                    next.1
+                } else {
+                    before.1
+                },
+                if next.2 != self.external.2 {
+                    next.2
+                } else {
+                    before.2
+                },
+                0,
+                0,
+                if next.3 != self.external.3 {
+                    next.3
+                } else {
+                    before.3
+                },
+            );
+        }
+        self.external = next;
+        before != self.modifiers()
+    }
+}
+
+pub fn snapshot(niri: &mut Niri) -> zbus::fdo::Result<String> {
+    let keyboard = niri.niri.seat.get_keyboard().unwrap();
+    let map = keyboard.with_xkb_state(niri, |context| {
+        context.xkb().lock().unwrap().keymap_as_string()
+    });
+    if map.is_empty() || map.len() > 256 * 1024 {
+        return Err(zbus::fdo::Error::LimitsExceeded(
+            "capture keymap exceeds limit".into(),
+        ));
+    }
+    Ok(map)
+}
diff --git a/src/dbus/input_capture/masks.rs b/src/dbus/input_capture/masks.rs
--- /dev/null
+++ b/src/dbus/input_capture/masks.rs
@@ -0,0 +1,316 @@
+//! Explicit virtual-keyboard modifier ownership across capture boundaries.
+use std::collections::BTreeMap;
+
+pub type Modifiers = (u32, u32, u32, u32);
+const MAX_SOURCES: usize = 256;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Refusal {
+    Exhausted,
+    Phase,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Output {
+    pub ordinary: Option<Modifiers>,
+    pub captured: Option<Modifiers>,
+}
+#[derive(Default)]
+struct Source {
+    local: [u32; 3],
+    captured: u32,
+    suppressed: u32,
+    pending: bool,
+    participated: bool,
+}
+#[derive(Default)]
+pub struct Masks {
+    sources: BTreeMap<u64, Source>,
+    active: bool,
+    exhausted: bool,
+}
+impl Masks {
+    pub fn activate(&mut self) -> Result<(), Refusal> {
+        if self.exhausted {
+            return Err(Refusal::Exhausted);
+        }
+        if self.active {
+            return Err(Refusal::Phase);
+        }
+        self.active = true;
+        Ok(())
+    }
+    pub fn retire(&mut self, raw_tail: impl Fn(u64) -> bool) {
+        self.active = false;
+        for (&id, source) in &mut self.sources {
+            let held = source.captured != 0 || raw_tail(id);
+            source.suppressed |= source.captured;
+            source.captured = 0;
+            source.pending |= held;
+            source.participated = false;
+        }
+    }
+    fn source(&mut self, id: u64) -> Result<&mut Source, Refusal> {
+        if !self.sources.contains_key(&id) && self.sources.len() >= MAX_SOURCES {
+            self.exhausted = true;
+            return Err(Refusal::Exhausted);
+        }
+        Ok(self.sources.entry(id).or_default())
+    }
+    pub fn record_capture(&mut self, id: u64, raw_tail: bool) -> Result<(), Refusal> {
+        if !self.active {
+            return Err(Refusal::Phase);
+        }
+        let source = self.source(id)?;
+        source.participated = true;
+        if !raw_tail {
+            source.pending = false;
+        }
+        Ok(())
+    }
+    pub fn local_input(&mut self, id: u64) {
+        if let Some(source) = self.sources.get_mut(&id) {
+            source.pending = false;
+        }
+    }
+    pub fn participates(&self, id: u64) -> bool {
+        self.active
+            && self
+                .sources
+                .get(&id)
+                .is_some_and(|source| source.participated)
+    }
+    pub fn remove_source(&mut self, id: u64) {
+        self.sources.remove(&id);
+    }
+    pub fn local_depressed(&self) -> u32 {
+        self.sources
+            .values()
+            .fold(0, |mask, source| mask | source.local[0])
+    }
+    pub fn update(
+        &mut self,
+        id: u64,
+        input: Modifiers,
+        main: Modifiers,
+        capture: Option<Modifiers>,
+        raw_tail: bool,
+    ) -> Result<Output, Refusal> {
+        if self.active != capture.is_some() {
+            return Err(Refusal::Phase);
+        }
+        let source = self.source(id)?;
+        let old_local = source.local;
+        let old_suppressed = source.suppressed;
+        let quarantine = source.pending || raw_tail;
+        let seen = source.local[0] | source.captured | source.suppressed;
+        source.local[0] &= input.0;
+        source.captured &= input.0;
+        source.suppressed &= input.0;
+        let new = input.0 & !seen;
+        if quarantine {
+            source.suppressed |= new;
+        } else if capture.is_some() {
+            source.captured |= new;
+        } else {
+            source.local[0] |= new;
+        }
+        if let Some(current) = capture {
+            source.participated = true;
+            source.local[1] &= input.1;
+            source.local[2] &= input.2;
+            let ordinary = (old_local != [0; 3] || source.local != [0; 3]).then_some((
+                (main.0 & !old_local[0]) | source.local[0],
+                (main.1 & !old_local[1]) | source.local[1],
+                (main.2 & !old_local[2]) | source.local[2],
+                main.3,
+            ));
+            let depressed = if quarantine {
+                (current.0 & !old_local[0]) | source.local[0] | source.captured
+            } else {
+                source.local[0] | source.captured
+            };
+            if !raw_tail && input.0 == 0 {
+                source.pending = false;
+            }
+            Ok(Output {
+                ordinary,
+                captured: Some((depressed, input.1, input.2, input.3)),
+            })
+        } else {
+            source.local[1] = input.1;
+            source.local[2] = input.2;
+            let depressed = if quarantine || old_suppressed != 0 || source.suppressed != 0 {
+                (main.0 & !old_local[0]) | source.local[0]
+            } else {
+                input.0
+            };
+            if !raw_tail && input.0 == 0 {
+                source.pending = false;
+            }
+            Ok(Output {
+                ordinary: Some((depressed, input.1, input.2, input.3)),
+                captured: None,
+            })
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const ZERO: Modifiers = (0, 0, 0, 0);
+    #[test]
+    fn old_local_control_can_clear_without_importing_new_captured_shift() {
+        let mut masks = Masks::default();
+        assert_eq!(
+            masks
+                .update(1, (4, 0, 0, 0), ZERO, None, false)
+                .unwrap()
+                .ordinary,
+            Some((4, 0, 0, 0))
+        );
+        assert_eq!(masks.local_depressed(), 4);
+        masks.activate().unwrap();
+        let result = masks
+            .update(1, (5, 0, 0, 0), (4, 0, 0, 0), Some((5, 0, 0, 0)), false)
+            .unwrap();
+        assert_eq!(result.ordinary, Some((4, 0, 0, 0)));
+        assert_eq!(result.captured, Some((5, 0, 0, 0)));
+        let result = masks
+            .update(1, (1, 0, 0, 0), (4, 0, 0, 0), Some((5, 0, 0, 0)), false)
+            .unwrap();
+        assert_eq!(result.ordinary, Some(ZERO));
+        assert_eq!(result.captured, Some((1, 0, 0, 0)));
+    }
+    #[test]
+    fn captured_modifier_only_updates_stay_suppressed_through_stop_and_a_new_activation() {
+        let mut masks = Masks::default();
+        masks.activate().unwrap();
+        assert_eq!(
+            masks
+                .update(1, (12, 0, 0, 0), ZERO, Some(ZERO), false)
+                .unwrap()
+                .ordinary,
+            None
+        );
+        masks.retire(|_| false);
+        assert_eq!(
+            masks
+                .update(1, (4, 0, 0, 0), ZERO, None, false)
+                .unwrap()
+                .ordinary,
+            Some(ZERO)
+        );
+        masks.activate().unwrap();
+        let result = masks
+            .update(1, (4, 0, 0, 0), ZERO, Some(ZERO), false)
+            .unwrap();
+        assert_eq!(result.captured, Some(ZERO));
+        assert_eq!(result.ordinary, None);
+        masks.update(1, ZERO, ZERO, Some(ZERO), false).unwrap();
+        let result = masks
+            .update(1, (1, 0, 0, 0), ZERO, Some(ZERO), false)
+            .unwrap();
+        assert_eq!(result.captured, Some((1, 0, 0, 0)));
+    }
+    #[test]
+    fn first_late_modifier_packet_after_a_raw_captured_key_does_not_create_a_local_press() {
+        let mut masks = Masks::default();
+        masks.activate().unwrap();
+        masks.record_capture(1, false).unwrap();
+        masks.retire(|id| id == 1);
+        assert_eq!(
+            masks
+                .update(1, (4, 0, 0, 0), ZERO, None, true)
+                .unwrap()
+                .ordinary,
+            Some(ZERO)
+        );
+        // Clearing the old modifier must preserve an unrelated local Shift.
+        assert_eq!(
+            masks
+                .update(1, ZERO, (1, 0, 0, 0), None, false)
+                .unwrap()
+                .ordinary,
+            Some((1, 0, 0, 0))
+        );
+        masks.local_input(1);
+        assert_eq!(
+            masks
+                .update(1, (8, 0, 0, 0), ZERO, None, false)
+                .unwrap()
+                .ordinary,
+            Some((8, 0, 0, 0))
+        );
+    }
+    #[test]
+    fn a_fresh_raw_key_allows_new_modifiers_without_adopting_old_held_bits() {
+        let mut masks = Masks::default();
+        masks.activate().unwrap();
+        masks
+            .update(1, (4, 0, 0, 0), ZERO, Some(ZERO), false)
+            .unwrap();
+        masks.retire(|_| false);
+        masks.activate().unwrap();
+        masks.record_capture(1, false).unwrap();
+        let result = masks
+            .update(1, (5, 0, 0, 0), ZERO, Some((1, 0, 0, 0)), false)
+            .unwrap();
+        assert_eq!(result.captured, Some((1, 0, 0, 0)));
+        assert_eq!(result.ordinary, None);
+    }
+    #[test]
+    fn source_removal_and_bounded_admission_do_not_clear_other_sources() {
+        let mut masks = Masks::default();
+        for id in 1..=MAX_SOURCES as u64 {
+            masks.update(id, (4, 0, 0, 0), ZERO, None, false).unwrap();
+        }
+        assert_eq!(
+            masks.update(MAX_SOURCES as u64 + 1, ZERO, ZERO, None, false),
+            Err(Refusal::Exhausted)
+        );
+        assert_eq!(masks.activate(), Err(Refusal::Exhausted));
+        masks.remove_source(1);
+        assert_eq!(masks.local_depressed(), 4);
+        for id in 2..=MAX_SOURCES as u64 {
+            masks.remove_source(id);
+        }
+        assert_eq!(masks.local_depressed(), 0);
+    }
+    #[test]
+    fn normal_absolute_virtual_mask_and_group_semantics_are_unchanged_outside_capture() {
+        let mut masks = Masks::default();
+        assert_eq!(
+            masks
+                .update(1, (0, 1, 2, 3), (7, 8, 9, 0), None, false)
+                .unwrap()
+                .ordinary,
+            Some((0, 1, 2, 3))
+        );
+        assert!(!masks.participates(1));
+        masks.activate().unwrap();
+        assert_eq!(masks.activate(), Err(Refusal::Phase));
+        assert_eq!(
+            masks.update(1, ZERO, ZERO, None, false),
+            Err(Refusal::Phase)
+        );
+        masks.record_capture(1, false).unwrap();
+        assert!(masks.participates(1));
+        masks.retire(|_| false);
+        assert!(!masks.participates(1));
+    }
+    #[test]
+    fn a_completed_key_does_not_quarantine_a_fresh_modifier_only_press_after_stop() {
+        let mut masks = Masks::default();
+        masks.activate().unwrap();
+        masks.record_capture(1, false).unwrap();
+        // The raw key finished before capture stopped, with no held mask.
+        masks.retire(|_| false);
+        assert_eq!(
+            masks
+                .update(1, (4, 0, 0, 0), ZERO, None, false)
+                .unwrap()
+                .ordinary,
+            Some((4, 0, 0, 0))
+        );
+    }
+}
