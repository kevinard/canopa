@@ -0,0 +1,265 @@
+//! Capture selection identities and live metadata, owned by the compositor loop.
+//! IPC display names and cached output projections are not object identities.
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+
+use smithay::output::Output;
+use zbus::fdo;
+
+use crate::niri::{CastTarget, Niri, State};
+use crate::utils::{CastSessionId, CastStreamId};
+
+mod identity;
+pub mod mapping;
+const MAX_PINS: usize = 64;
+
+pub enum Request {
+    Monitor(String),
+    Window(u64),
+}
+
+pub enum Message {
+    Pin {
+        session: CastSessionId,
+        stream: CastStreamId,
+        target: Request,
+        expected: Option<u64>,
+        mapping_id: String,
+        stopped: Arc<AtomicBool>,
+        reply: async_channel::Sender<fdo::Result<()>>,
+    },
+    Metadata {
+        session: CastSessionId,
+        stream: CastStreamId,
+        reply: async_channel::Sender<fdo::Result<Metadata>>,
+    },
+    MonitorInfo {
+        name: String,
+        reply: async_channel::Sender<fdo::Result<Metadata>>,
+    },
+}
+
+#[derive(Debug, Clone)]
+pub struct Metadata {
+    pub source_id: Option<u64>,
+    pub position: (i32, i32),
+    pub size: (i32, i32),
+    pub mapping_id: Option<String>,
+    pub physical_scale: Option<f64>,
+}
+
+#[derive(Clone)]
+pub enum Target {
+    Fixed { target: CastTarget, source_id: u64 },
+    Dynamic,
+}
+struct Pin {
+    session: CastSessionId,
+    target: Target,
+    mapping_id: String,
+    stopped: Arc<AtomicBool>,
+}
+#[derive(Default)]
+pub struct Sources(HashMap<CastStreamId, Pin>);
+impl Sources {
+    pub fn target(&self, session: CastSessionId, stream: CastStreamId) -> Option<Target> {
+        self.0
+            .get(&stream)
+            .filter(|pin| pin.session == session && !pin.stopped.load(Ordering::Acquire))
+            .map(|pin| pin.target.clone())
+    }
+    pub fn stop(&mut self, session: CastSessionId) {
+        self.0.retain(|_, pin| pin.session != session);
+    }
+    fn metadata(
+        &self,
+        niri: &Niri,
+        session: CastSessionId,
+        stream: CastStreamId,
+    ) -> fdo::Result<Metadata> {
+        let pin = self
+            .0
+            .get(&stream)
+            .filter(|pin| pin.session == session && !pin.stopped.load(Ordering::Acquire))
+            .ok_or_else(unavailable)?;
+        match &pin.target {
+            Target::Fixed { target, source_id } => {
+                let mut metadata = target_metadata(niri, target)?;
+                metadata.source_id = Some(*source_id);
+                metadata.mapping_id = Some(pin.mapping_id.clone());
+                Ok(metadata)
+            }
+            // Keep the existing Mutter dynamic-picker placeholder before it has
+            // selected a target. It is never an approved absolute-input mapping.
+            Target::Dynamic => Ok(Metadata {
+                source_id: None,
+                position: (0, 0),
+                size: (1, 1),
+                mapping_id: None,
+                physical_scale: None,
+            }),
+        }
+    }
+}
+
+fn unavailable() -> fdo::Error {
+    fdo::Error::Failed("capture source is unavailable".into())
+}
+
+/// Lives on the actual Output object. A new Output gets a different identity,
+/// even when its connector name or backend CRTC identifier was reused.
+fn output_identity(output: &Output) -> fdo::Result<u64> {
+    identity::identity(output)
+        .ok_or_else(|| fdo::Error::LimitsExceeded("capture identities exhausted".into()))
+}
+fn target_metadata(niri: &Niri, target: &CastTarget) -> fdo::Result<Metadata> {
+    let (position, size, physical_scale) = match target {
+        CastTarget::Output { output, .. } => {
+            let output = output
+                .upgrade()
+                .filter(|output| niri.output_exists(output))
+                .ok_or_else(unavailable)?;
+            let geo = niri
+                .global_space
+                .output_geometry(&output)
+                .ok_or_else(unavailable)?;
+            (
+                (geo.loc.x, geo.loc.y),
+                (geo.size.w, geo.size.h),
+                Some(output.current_scale().fractional_scale()),
+            )
+        }
+        CastTarget::Window { id } => {
+            let (_, mapped) = niri
+                .layout
+                .windows()
+                .find(|(_, mapped)| mapped.id().get() == *id)
+                .ok_or_else(unavailable)?;
+            let bbox = mapped.window.bbox_with_popups();
+            // The cast output determines the pixels in this recording, even
+            // when logical window dimensions stay fixed across output scaling.
+            let scale = niri
+                .casting
+                .mapped_cast_output
+                .get(&mapped.window)
+                .map(|output| output.current_scale().fractional_scale());
+            ((0, 0), (bbox.size.w, bbox.size.h), scale)
+        }
+        CastTarget::Nothing => return Err(unavailable()),
+    };
+    if !(1..=32768).contains(&size.0) || !(1..=32768).contains(&size.1) {
+        return Err(unavailable());
+    }
+    Ok(Metadata {
+        source_id: None,
+        position,
+        size,
+        mapping_id: None,
+        physical_scale,
+    })
+}
+fn resolve(niri: &Niri, request: Request, expected: Option<u64>) -> fdo::Result<Target> {
+    let (target, id) = match request {
+        Request::Monitor(name) => {
+            if name.is_empty() || name.len() > 256 || name.chars().any(char::is_control) {
+                return Err(fdo::Error::InvalidArgs("invalid connector name".into()));
+            }
+            let output = niri
+                .global_space
+                .outputs()
+                .find(|output| output.name() == name)
+                .ok_or_else(unavailable)?;
+            (CastTarget::output(output), output_identity(output)?)
+        }
+        Request::Window(id) if id == niri.casting.dynamic_cast_id_for_portal.get() => {
+            if expected.is_some() {
+                return Err(fdo::Error::InvalidArgs(
+                    "dynamic source has no fixed identity".into(),
+                ));
+            }
+            return Ok(Target::Dynamic);
+        }
+        Request::Window(id) => {
+            let target = CastTarget::Window { id };
+            target_metadata(niri, &target)?;
+            (target, id)
+        }
+    };
+    if expected.is_some_and(|value| value != id) {
+        return Err(fdo::Error::Failed("capture source identity changed".into()));
+    }
+    target_metadata(niri, &target)?;
+    Ok(Target::Fixed {
+        target,
+        source_id: id,
+    })
+}
+
+pub fn handle(state: &mut State, message: Message) {
+    match message {
+        Message::Pin {
+            session,
+            stream,
+            target,
+            expected,
+            mapping_id,
+            stopped,
+            reply,
+        } => {
+            let result = if stopped.load(Ordering::Acquire) {
+                Err(unavailable())
+            } else if state.niri.casting.sources.0.len() >= MAX_PINS {
+                Err(fdo::Error::LimitsExceeded(
+                    "too many capture source pins".into(),
+                ))
+            } else if state.niri.casting.sources.0.contains_key(&stream) {
+                Err(fdo::Error::Failed(
+                    "capture stream identity already exists".into(),
+                ))
+            } else {
+                resolve(&state.niri, target, expected).map(|target| {
+                    state.niri.casting.sources.0.insert(
+                        stream,
+                        Pin {
+                            session,
+                            target,
+                            mapping_id,
+                            stopped,
+                        },
+                    );
+                })
+            };
+            let inserted = result.is_ok();
+            if reply.try_send(result).is_err() && inserted {
+                state.niri.casting.sources.0.remove(&stream);
+            }
+        }
+        Message::Metadata {
+            session,
+            stream,
+            reply,
+        } => {
+            let _ = reply.try_send(state.niri.casting.sources.metadata(
+                &state.niri,
+                session,
+                stream,
+            ));
+        }
+        Message::MonitorInfo { name, reply } => {
+            let result =
+                resolve(&state.niri, Request::Monitor(name), None).and_then(
+                    |target| match target {
+                        Target::Fixed { target, source_id } => {
+                            let mut metadata = target_metadata(&state.niri, &target)?;
+                            metadata.source_id = Some(source_id);
+                            Ok(metadata)
+                        }
+                        Target::Dynamic => unreachable!(),
+                    },
+                );
+            let _ = reply.try_send(result);
+        }
+    }
+}
diff --git a/src/screencasting/sources/identity.rs b/src/screencasting/sources/identity.rs
--- /dev/null
+++ b/src/screencasting/sources/identity.rs
@@ -0,0 +1,98 @@
+//! Stable selection identity attached to the live Output, independent of its name.
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use smithay::output::Output;
+
+struct Identity(u64);
+pub fn identity(output: &Output) -> Option<u64> {
+    if let Some(id) = output.user_data().get::<Identity>() {
+        return Some(id.0);
+    }
+    static NEXT: AtomicU64 = AtomicU64::new(1);
+    let id = NEXT
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |id| id.checked_add(1))
+        .ok()?;
+    output
+        .user_data()
+        .insert_if_missing_threadsafe(|| Identity(id));
+    Some(output.user_data().get::<Identity>().unwrap().0)
+}
+#[cfg(test)]
+mod tests {
+    use smithay::output::{Mode, PhysicalProperties, Subpixel};
+
+    use super::*;
+    fn output() -> Output {
+        Output::new(
+            "same-name".into(),
+            PhysicalProperties {
+                size: (0, 0).into(),
+                subpixel: Subpixel::Unknown,
+                make: "private-test".into(),
+                model: "private-test".into(),
+                serial_number: "test".into(),
+            },
+        )
+    }
+    #[test]
+    fn clones_share_one_identity_and_equal_names_do_not() {
+        let a = output();
+        let b = output();
+        assert_eq!(identity(&a), identity(&a.clone()));
+        assert_ne!(identity(&a), identity(&b));
+    }
+    #[test]
+    fn replacement_cannot_revive_the_retired_output() {
+        let a = output();
+        let old = identity(&a).unwrap();
+        let weak = a.downgrade();
+        drop(a);
+        assert!(weak.upgrade().is_none());
+        let b = output();
+        assert_ne!(identity(&b), Some(old));
+        assert!(weak.upgrade().is_none());
+        assert_ne!(weak, b.downgrade());
+    }
+    #[test]
+    fn live_object_keeps_identity_across_mode_changes() {
+        let a = output();
+        let old = identity(&a);
+        a.change_current_state(
+            Some(Mode {
+                size: (800, 600).into(),
+                refresh: 60_000,
+            }),
+            None,
+            None,
+            None,
+        );
+        assert_eq!(identity(&a), old);
+        a.change_current_state(
+            Some(Mode {
+                size: (1024, 768).into(),
+                refresh: 60_000,
+            }),
+            None,
+            None,
+            None,
+        );
+        assert_eq!(identity(&a), old);
+    }
+    #[test]
+    fn concurrent_clones_observe_the_same_attached_identity() {
+        let a = output();
+        let barrier = std::sync::Arc::new(std::sync::Barrier::new(8));
+        let threads: Vec<_> = (0..8)
+            .map(|_| {
+                let a = a.clone();
+                let barrier = barrier.clone();
+                std::thread::spawn(move || {
+                    barrier.wait();
+                    identity(&a).unwrap()
+                })
+            })
+            .collect();
+        let ids: Vec<_> = threads.into_iter().map(|t| t.join().unwrap()).collect();
+        assert!(ids.iter().all(|id| Some(*id) == identity(&a)));
+    }
+}
diff --git a/src/screencasting/sources/mapping.rs b/src/screencasting/sources/mapping.rs
--- /dev/null
+++ b/src/screencasting/sources/mapping.rs
@@ -0,0 +1,168 @@
+//! Absolute input bindings to selected, live producer streams. Region dimensions and scale
+//! remain fixed for one lease, matching EI's immutable device region contract.
+
+use std::collections::HashSet;
+
+use smithay::utils::{Logical, Point};
+use zbus::fdo;
+
+use super::{unavailable, Metadata, Target};
+use crate::niri::{CastTarget, Niri};
+use crate::utils::{CastSessionId, CastStreamId};
+
+mod path;
+
+struct Region {
+    stream: CastStreamId,
+    metadata: Metadata,
+}
+pub struct Bindings {
+    session: CastSessionId,
+    regions: Vec<Region>,
+}
+impl Bindings {
+    pub fn new(niri: &Niri, session: &str, streams: &[String]) -> fdo::Result<Self> {
+        if streams.is_empty() || streams.len() > 16 {
+            return Err(fdo::Error::InvalidArgs(
+                "expected 1 to 16 capture streams".into(),
+            ));
+        }
+        let session = path::id(session, "Session").ok_or_else(unavailable)?;
+        let session = CastSessionId::from(session);
+        let mut seen = HashSet::new();
+        let mut regions = Vec::with_capacity(streams.len());
+        for name in streams {
+            let raw = path::id(name, "Stream").ok_or_else(unavailable)?;
+            if !seen.insert(raw) {
+                return Err(fdo::Error::InvalidArgs("duplicate capture stream".into()));
+            }
+            let stream = *niri
+                .casting
+                .sources
+                .0
+                .keys()
+                .find(|s| s.get() == raw)
+                .ok_or_else(unavailable)?;
+            let metadata = active_metadata(niri, session, stream)?;
+            regions.push(Region { stream, metadata });
+        }
+        Ok(Self { session, regions })
+    }
+
+    pub fn descriptors(&self) -> Vec<(u64, String, (i32, i32), f64)> {
+        self.regions
+            .iter()
+            .map(|r| {
+                (
+                    r.stream.get(),
+                    r.metadata.mapping_id.clone().unwrap(),
+                    r.metadata.size,
+                    r.metadata.physical_scale.expect("active scaled binding"),
+                )
+            })
+            .collect()
+    }
+
+    pub fn valid(&self, niri: &Niri) -> bool {
+        self.regions.iter().all(|r| {
+            active_metadata(niri, self.session, r.stream).is_ok_and(|m| {
+                m.source_id == r.metadata.source_id
+                    && m.mapping_id == r.metadata.mapping_id
+                    && m.size == r.metadata.size
+                    && m.physical_scale == r.metadata.physical_scale
+            })
+        })
+    }
+
+    pub fn point(&self, niri: &Niri, stream: u64, x: f64, y: f64) -> Option<Point<f64, Logical>> {
+        if !self.valid(niri) {
+            return None;
+        }
+        let region = self.regions.iter().find(|r| r.stream.get() == stream)?;
+        let (width, height) = region.metadata.size;
+        if !x.is_finite()
+            || !y.is_finite()
+            || x < 0.
+            || y < 0.
+            || x >= f64::from(width)
+            || y >= f64::from(height)
+        {
+            return None;
+        }
+        let Target::Fixed { target, .. } =
+            niri.casting.sources.target(self.session, region.stream)?
+        else {
+            return None;
+        };
+        match target {
+            CastTarget::Output { output, .. } => {
+                let output = output.upgrade().filter(|o| niri.output_exists(o))?;
+                let geo = niri.global_space.output_geometry(&output)?;
+                // These are already the captured output's logical coordinates,
+                // including its transform. Do not apply hardware transforms again.
+                Some(geo.loc.to_f64() + Point::from((x, y)))
+            }
+            CastTarget::Window { id } => {
+                let (_, mapped) = niri.layout.windows().find(|(_, m)| m.id().get() == id)?;
+                let (output, surface_origin) = niri.layout.window_surface_origin(&mapped.window)?;
+                let geo = niri.global_space.output_geometry(output)?;
+                let cast_output = niri.casting.mapped_cast_output.get(&mapped.window)?;
+                let scale = cast_output.current_scale().fractional_scale();
+                // Match render_for_screen_cast's physically rounded popup bbox,
+                // then convert the stream's logical region into those video pixels.
+                let bbox = mapped
+                    .window
+                    .bbox_with_popups()
+                    .to_physical_precise_up::<_, i32>(scale);
+                let within_surface = bbox.loc.to_f64().to_logical(scale)
+                    + Point::from((
+                        x * f64::from(bbox.size.w) / (scale * f64::from(width)),
+                        y * f64::from(bbox.size.h) / (scale * f64::from(height)),
+                    ));
+                let point = geo.loc.to_f64() + surface_origin + within_surface;
+                // Offscreen, obscured, overview and input-region holes cannot
+                // silently redirect a window stream's absolute point elsewhere.
+                let under = niri.contents_under(point);
+                if under.surface.is_none()
+                    || !under
+                        .window
+                        .is_some_and(|(window, _)| window == mapped.window)
+                {
+                    return None;
+                }
+                Some(point)
+            }
+            CastTarget::Nothing => None,
+        }
+    }
+}
+
+fn active_metadata(
+    niri: &Niri,
+    session: CastSessionId,
+    stream: CastStreamId,
+) -> fdo::Result<Metadata> {
+    let Some(Target::Fixed { target, .. }) = niri.casting.sources.target(session, stream) else {
+        return Err(unavailable());
+    };
+    // A selected pin or a recycled PipeWire node number is insufficient. This
+    // exact session/stream must still own a producer and its selected target.
+    if !niri.casting.casts.iter().any(|cast| {
+        cast.session_id == session
+            && cast.stream_id == stream
+            && cast.target == target
+            && cast.node_id().is_some()
+    }) {
+        return Err(unavailable());
+    }
+    let metadata = niri.casting.sources.metadata(niri, session, stream)?;
+    if metadata.mapping_id.is_none()
+        || metadata.source_id.is_none()
+        || !metadata
+            .physical_scale
+            .is_some_and(|scale| scale.is_finite() && scale > 0. && scale <= 64.)
+    {
+        return Err(unavailable());
+    }
+    Ok(metadata)
+}
