+        let previous = e.describe(id).unwrap();
+        assert!(matches!(
+            e.replace(
+                id,
+                e.describe(id).unwrap().generation,
+                vec![definition(1, "q"), definition(1, "w")],
+                |_, _| false,
+                3000
+            ),
+            Err(Error::InvalidDefinitions)
