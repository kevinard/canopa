[Desktop Entry]
Type=Application
Name=Canopa Files
Name[fr]=Fichiers Canopa
GenericName=File Manager
GenericName[fr]=Gestionnaire de fichiers
Comment=Browse and manage local files
Comment[fr]=Parcourir et gérer les fichiers locaux
Exec=canopa-files %U
TryExec=canopa-files
Icon=system-file-manager
Terminal=false
StartupNotify=true
Categories=System;FileManager;
MimeType=inode/directory;
Keywords=Files;Folders;Browser;
Keywords[fr]=Fichiers;Dossiers;Navigateur;Explorateur;
