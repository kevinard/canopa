// Canopa compositor defaults. Per-user input/display and custom files follow.
prefer-no-csd
layout {
    // Workspaces are clear over the stationary desktop backdrop. The matching
    // dark backdrop blends with the login screen until the wallpaper appears.
    background-color "#10191d00"
    // The compositor owns frames for applications that negotiated SSD.
    // Settings generates chrome colors and title typography from appearance.
    // These values match the built-in dark appearance.
    titlebar {
        on
        // The layout button opens a menu for the column width, pinning,
        // floating and tabs.
        buttons "layout" "maximize" "close"
        height 36
        font "Inter, sans-serif Medium 14px"
        active-color "#2e483e"
        inactive-color "#212727"
        text-color "#edf4f0"
        inactive-text-color "#edf4f0a6"
        button-hover-color "#edf4f026"
        close-hover-color "#d65a54"
    }
    gaps 16
    clip-scroll-to-work-area
    // The window bar slides in from the top edge, during keyboard navigation and with
    // Super+Shift+B, rather than keeping a row of its own.
    window-bar "on-demand"
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    // Mod+R cycles the focused column through these widths.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    focus-ring { off; }
    border {
        on
        // 2 pixels at 100%, a little more at fractional scales.
        width 2
        active-color "#b0dec3"
        active-gradient from="#96bea9" to="#749486" angle=155
        inactive-color "#ffffff33"
        urgent-color "#f9e2af"
    }
    tab-indicator { gap 4; width 5; corner-radius 3; }
    insert-hint { color "#b0dec35c"; }
    // Tiled columns have a shallow shadow. Floating windows get more depth.
    shadow { on; softness 28; spread 0; offset x=0 y=6; color "#000000b3"; inactive-color "#00000073"; }
}
// Match the window clip to the frame.
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}
// Floating windows use rounder corners and enough shadow to separate from
// the windows beneath them.
window-rule {
    match is-floating=true
    geometry-corner-radius 20
    shadow { on; softness 40; spread 0; offset x=0 y=16; color "#00000099"; inactive-color "#0000006b"; }
}
// Authentication and passphrase prompts, and portal dialogs (file chooser,
// screen sharing, …) even when the application gave no parent window, float
// over the strip instead of opening a column. Niri already floats Quick Look
// and other parented dialogs.
window-rule {
    match app-id="^org\\.canopa\\.(Pinentry|Keyring|Polkit|Portal)$"
    open-floating true
}
// Authentication and passphrase prompts take focus. A bright focus border would
// compete with their default action: a faint neutral edge and a deeper shadow
// separate them from the desktop instead.
window-rule {
    match app-id="^org\\.canopa\\.(Pinentry|Keyring|Polkit)$"
    open-focused true
    border { on; width 1; active-color "#ffffff24"; inactive-color "#ffffff14"; }
    shadow { on; softness 48; spread 2; offset x=0 y=20; color "#000000a6"; inactive-color "#00000073"; }
}
// The wallpaper stays behind the zoomed-out workspaces in the overview.
layer-rule {
    match namespace="^canopa(-shell)?-wallpaper$"
    place-within-backdrop true
}
// Typing in the overview searches the launcher: Niri reports the text and
// Canopa Shell opens Applications with it.
overview {
    emit-typed-text
    backdrop-color "#10191d"
    // Each workspace is named above it.
    workspace-labels
}
animations {
    horizontal-view-movement { duration-ms 300; curve "ease-out-cubic"; }
    workspace-switch { spring damping-ratio=1.0 stiffness=760 epsilon=0.0001; }
    overview-open-close { duration-ms 400; curve "ease-out-cubic"; }
    // Windows grow in place from 92% while fading in, and shrink to 96% while
    // fading out. The fade finishes early, so a new window is never seen as a
    // translucent sheet for long while the columns around it move.
    window-open {
        duration-ms 220
        curve "ease-out-cubic"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = 0.92 + 0.08 * p;
                vec3 coords = vec3((coords_geo.xy - vec2(0.5)) / scale + vec2(0.5), 1.0);
                if (coords.x < 0.0 || coords.x > 1.0 || coords.y < 0.0 || coords.y > 1.0)
                    return vec4(0.0);
                vec3 coords_tex = niri_geo_to_tex * coords;
                return texture2D(niri_tex, coords_tex.st) * smoothstep(0.0, 0.4, p);
            }
        "
    }
    window-close {
        duration-ms 160
        curve "ease-out-quad"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = 1.0 - 0.04 * p;
                vec3 coords = vec3((coords_geo.xy - vec2(0.5)) / scale + vec2(0.5), 1.0);
                if (coords.x < 0.0 || coords.x > 1.0 || coords.y < 0.0 || coords.y > 1.0)
                    return vec4(0.0);
                vec3 coords_tex = niri_geo_to_tex * coords;
                return texture2D(niri_tex, coords_tex.st) * (1.0 - p);
            }
        "
    }
}
// Pushing the pointer into the top-left corner opens the overview.
gestures {
    hot-corners { top-left; }
}
hotkey-overlay { skip-at-startup; }
// Niri renames the desktop to "niri" when it starts as a session; applications
// it spawns keep Canopa's name for OnlyShowIn and default-application lookups.
environment {
    XDG_CURRENT_DESKTOP "canopa:niri"
}
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
binds {
    Mod+Return { spawn "xdg-terminal-exec"; }
    Mod+Space { spawn "canopa-shell" "--toggle-menu" "Applications"; }
    Mod+B { spawn "canopa-shell" "--toggle-bar"; }
    // Shows or hides the window bar when Settings sets it to show on demand.
    Mod+Shift+B { toggle-window-bar; }
    Mod+E { spawn "canopa-files"; }
    Mod+Comma { spawn "canopa-settings"; }
    Mod+L { spawn "canopa-lock"; }
    Mod+Q { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Ctrl+Up { focus-workspace-up; }
    Mod+Ctrl+Down { focus-workspace-down; }
    Mod+Shift+Ctrl+Up { move-column-to-workspace-up; }
    Mod+Shift+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End { move-column-to-last; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+P { toggle-pinned-column "left"; }
    Mod+Shift+P { toggle-pinned-column "right"; }
    // Folds pinned columns past their edges to give their space back, or unfolds them.
    Mod+Ctrl+P { toggle-pinned-column-folded; }
    // The scratchpad: a floating window shown and hidden on demand, on any workspace.
    Mod+Grave { toggle-scratchpad; }
    Mod+Shift+Grave { toggle-window-in-scratchpad; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+O { toggle-overview; }
    Mod+Shift+E { quit; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "canopa-shell" "volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "canopa-shell" "volume" "down"; }
    XF86AudioMute allow-when-locked=true repeat=false { spawn "canopa-shell" "volume" "mute"; }
    XF86AudioMicMute allow-when-locked=true repeat=false { spawn "canopa-shell" "microphone" "mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "canopa-shell" "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "canopa-shell" "brightness" "down"; }
    XF86KbdBrightnessUp { spawn "canopa-shell" "keyboard-backlight" "up"; }
    XF86KbdBrightnessDown { spawn "canopa-shell" "keyboard-backlight" "down"; }
    XF86KbdLightOnOff repeat=false { spawn "canopa-shell" "keyboard-backlight" "toggle"; }
    XF86AudioPlay allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "play-pause"; }
    XF86AudioPause allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "pause"; }
    XF86AudioStop allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "stop"; }
    XF86AudioNext allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "next"; }
    XF86AudioPrev allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "previous"; }
}
