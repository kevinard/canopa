// Canopa compositor defaults. Per-user input/display and custom files follow.
prefer-no-csd
layout {
    gaps 12
    center-focused-column "on-overflow"
    default-column-width { proportion 0.5; }
    focus-ring { width 2; active-color "#89b4fa"; inactive-color "#45475a"; }
    border { off; }
}
hotkey-overlay { skip-at-startup; }
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
binds {
    Mod+Return { spawn "foot"; }
    Mod+Space { spawn "canopa-shell" "--toggle-menu" "Applications"; }
    Mod+E { spawn "canopa-files"; }
    Mod+Comma { spawn "canopa-settings"; }
    Mod+L { spawn "canopa-lock"; }
    Mod+Q { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Ctrl+Up { focus-workspace-up; }
    Mod+Ctrl+Down { focus-workspace-down; }
    Mod+Shift+Ctrl+Up { move-column-to-workspace-up; }
    Mod+Shift+Ctrl+Down { move-column-to-workspace-down; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+O { toggle-overview; }
    Mod+Shift+E { quit; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "canopa-shell" "volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "canopa-shell" "volume" "down"; }
    XF86AudioMute allow-when-locked=true repeat=false { spawn "canopa-shell" "volume" "mute"; }
    XF86AudioMicMute allow-when-locked=true repeat=false { spawn "canopa-shell" "microphone" "mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "canopa-shell" "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "canopa-shell" "brightness" "down"; }
    XF86KbdBrightnessUp { spawn "canopa-shell" "keyboard-backlight" "up"; }
    XF86KbdBrightnessDown { spawn "canopa-shell" "keyboard-backlight" "down"; }
    XF86KbdLightOnOff repeat=false { spawn "canopa-shell" "keyboard-backlight" "toggle"; }
    XF86AudioPlay allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "play-pause"; }
    XF86AudioPause allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "pause"; }
    XF86AudioStop allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "stop"; }
    XF86AudioNext allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "next"; }
    XF86AudioPrev allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "previous"; }
}
