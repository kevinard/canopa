// Canopa compositor defaults. Per-user input/display and custom files follow.
prefer-no-csd
layout {
    gaps 12
    center-focused-column "on-overflow"
    default-column-width { proportion 0.5; }
    // Mod+R cycles the focused column through these widths.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    focus-ring { width 2; active-color "#7d938e"; inactive-color "#3e5450"; }
    border { off; }
    // Windows sit on a soft shadow so floating dialogs separate from their parent.
    shadow { on; softness 28; spread 2; offset x=0 y=6; color "#00000070"; }
}
// Every window shares the Canopa surface radius; content is clipped to it.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
// Floating dialogs are outlined by a hairline and a deeper shadow rather than
// the tiling focus ring, which stays for columns.
window-rule {
    match is-floating=true
    focus-ring { off; }
    border { on; width 1; active-color "#9aaba78c"; inactive-color "#9aaba759"; }
    shadow { on; softness 20; spread 0; offset x=0 y=6; color "#00000040"; }
}
// Authentication and passphrase prompts float over the strip instead of
// opening a column. Niri already floats Quick Look and other parented dialogs.
window-rule {
    match app-id="^org\\.canopa\\.(Pinentry|Keyring|Polkit)$"
    open-floating true
}
// The wallpaper stays behind the zoomed-out workspaces in the overview.
layer-rule {
    match namespace="^canopa-shell-wallpaper$"
    place-within-backdrop true
}
// Typing in the overview searches the launcher: Niri reports the text and
// Canopa Shell opens Applications with it.
overview {
    emit-typed-text
}
// Pushing the pointer into the top-left corner opens the overview.
gestures {
    hot-corners { top-left; }
}
hotkey-overlay { skip-at-startup; }
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
binds {
    Mod+Return { spawn "xdg-terminal-exec"; }
    Mod+Space { spawn "canopa-shell" "--toggle-menu" "Applications"; }
    Mod+E { spawn "canopa-files"; }
    Mod+Comma { spawn "canopa-settings"; }
    Mod+L { spawn "canopa-lock"; }
    Mod+Q { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Ctrl+Up { focus-workspace-up; }
    Mod+Ctrl+Down { focus-workspace-down; }
    Mod+Shift+Ctrl+Up { move-column-to-workspace-up; }
    Mod+Shift+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End { move-column-to-last; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+P { toggle-pinned-column "left"; }
    Mod+Shift+P { toggle-pinned-column "right"; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+O { toggle-overview; }
    Mod+Shift+E { quit; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "canopa-shell" "volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "canopa-shell" "volume" "down"; }
    XF86AudioMute allow-when-locked=true repeat=false { spawn "canopa-shell" "volume" "mute"; }
    XF86AudioMicMute allow-when-locked=true repeat=false { spawn "canopa-shell" "microphone" "mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "canopa-shell" "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "canopa-shell" "brightness" "down"; }
    XF86KbdBrightnessUp { spawn "canopa-shell" "keyboard-backlight" "up"; }
    XF86KbdBrightnessDown { spawn "canopa-shell" "keyboard-backlight" "down"; }
    XF86KbdLightOnOff repeat=false { spawn "canopa-shell" "keyboard-backlight" "toggle"; }
    XF86AudioPlay allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "play-pause"; }
    XF86AudioPause allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "pause"; }
    XF86AudioStop allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "stop"; }
    XF86AudioNext allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "next"; }
    XF86AudioPrev allow-when-locked=true repeat=false { spawn "canopa-shell" "media" "previous"; }
}
