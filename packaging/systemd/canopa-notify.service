[Unit]
Description=Canopa Notify notification daemon
Documentation=man:canopa-notify(1)
PartOf=graphical-session.target canopa-session.target
After=graphical-session-pre.target niri.service
Before=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/canopa-notify daemon --service --socket %t/canopa-notify/control.sock
Restart=on-failure

[Install]
WantedBy=graphical-session.target
