[Unit]
Description=Canopa Notify notification daemon
Documentation=man:canopa-notify(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=canopa-notify daemon --service --socket %t/canopa-notify/control.sock
Restart=on-failure

[Install]
WantedBy=graphical-session.target
