[Unit]
Description=Canopa logind session lock listener
After=graphical-session-pre.target niri.service
Before=graphical-session.target
PartOf=graphical-session.target canopa-session.target
ConditionPathExists=/etc/pam.d/canopa-lock

[Service]
Type=notify
NotifyAccess=main
ExecStart=%h/.local/bin/canopa-lock daemon
# A requested lock has an independent lifetime, including while this listener updates.
KillMode=process
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
