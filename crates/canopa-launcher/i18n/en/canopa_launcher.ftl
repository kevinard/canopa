# Canopa Launcher contracts. English is the source language.

## Launcher preferences, shared by the Shell launcher and Settings

launcher-invalid-shortcut = Invalid shortcut target
launcher-invalid-template = Search template requires one {"{"}query{"}"} placeholder in an HTTP(S) URL
launcher-invalid-search-url = Invalid search URL
launcher-invalid-preferences = Invalid launcher preference limits or web template
launcher-extension-keywords = Enabled extension keywords must be unique nonreserved words
launcher-extension-keyword-conflict = Extension keyword conflicts with a bundled extension
launcher-search-shortcuts = Search shortcuts require unique keywords and valid URL templates
launcher-shortcut-names = Shortcut names and aliases must be valid and unique
launcher-invalid-json = Invalid launcher preferences JSON
launcher-preferences-too-large = Launcher preferences exceed budget
launcher-no-preferences-directory = Missing preferences directory
launcher-invalid-lock = Invalid launcher preferences lock
launcher-preferences-busy = Launcher preferences are busy; try again
launcher-no-storage-directory = No absolute launcher storage directory
launcher-catalog-too-large = Extension catalog exceeds budget

## Clipboard history and snippets

launcher-clipboard-invalid = Clipboard preferences or snippets are invalid
launcher-clipboard-unreadable = Could not read saved clipboard preferences and snippets
launcher-clipboard-unsaved = Could not save clipboard preferences and snippets
# $bytes is the limit in bytes.
launcher-snippet-name = Enter a snippet name up to { $bytes } bytes
launcher-snippet-exists = A snippet with that name already exists
launcher-snippet-limit = Delete a snippet before saving another
launcher-snippet-gone = That snippet is no longer available
