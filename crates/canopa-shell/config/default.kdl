// To start canopa-shell automatically with your Wayland session:
//
//   # Copy the service file (if not installed by your package manager)
//   cp packaging/systemd/canopa-shell.service ~/.config/systemd/user/
//
//   # Enable and start the service
//   systemctl --user enable --now canopa-shell.service
//
// To enable diagnostics for a systemd-run instance, set environment variables
// in a user drop-in, for example:
//
//   systemctl --user edit canopa-shell.service
//   [Service]
//   Environment=RUST_LOG=canopa_shell=debug
//   Environment=CANOPA_SHELL_PERF=1
//
// The service starts with the graphical session and restarts on failure.
//
// canopa-shell default configuration
// Put these declarations inside the shell block of ~/.config/canopa/config.kdl.
// See docs/configuration.md for the shared envelope and legacy-file migration.

// ─── Menus ───────────────────────────────────────────────────────────────────
// Named panel menus can be opened from bar or module actions.
// Use launch for desktop applications; command actions are bounded automation.
// `session "suspend"`, "hibernate", "reboot" or "power-off" asks logind directly:
// polkit can prompt for a password, failures and blocking applications are
// reported, and buttons for actions logind refuses are hidden.
//
// Built-in texts use message IDs (`title-id`, `prompt-id`, `label-id`) so they
// follow the session language; write `prompt="…"` or `item "My label"` for
// your own text. A menu's name stays its identifier for `open-menu`.
menus {
    menu "Applications" show-icons=#true prompt-id="shell-menu-launcher-prompt" {
        source "launcher"
    }
    // Quick settings keeps Lock and Suspend at hand; the rest is one step away.
    // Items whose session action logind refuses are left out.
    menu "Power" title-id="shell-menu-power-title" {
        item label-id="shell-module-hibernate" { session "hibernate"; }
        item label-id="shell-menu-log-out-more" { open-menu "Log out?"; }
        item label-id="shell-menu-reboot-more" { open-menu "Reboot?"; }
        item label-id="shell-menu-power-off-more" { open-menu "Power off?"; }
    }
    // Cancel is first so Enter never ends the session by default.
    menu "Log out?" title-id="shell-menu-log-out-title" prompt-id="shell-menu-unsaved-work" {
        item label-id="shell-menu-cancel" { open-bar-panel; }
        item label-id="shell-menu-log-out" { command { argv "niri" "msg" "action" "quit" "--skip-confirmation"; }; }
    }
    menu "Reboot?" title-id="shell-menu-reboot-title" prompt-id="shell-menu-unsaved-work" {
        item label-id="shell-menu-cancel" { open-bar-panel; }
        item label-id="shell-menu-reboot" { session "reboot"; }
    }
    menu "Power off?" title-id="shell-menu-power-off-title" prompt-id="shell-menu-unsaved-work" {
        item label-id="shell-menu-cancel" { open-bar-panel; }
        item label-id="shell-menu-power-off" { session "power-off"; }
    }
}

// ─── External Panel Providers ────────────────────────────────────────────────
// Named out-of-process providers can own rich panel content while Canopa Shell owns
// the panel window, styling, focus, and input routing. Open them from actions
// with `open-provider "name"`. Built-in providers do not need declarations.
// See docs/shell/external-panel-providers.md.
// panel-providers {
//     provider "wifi" {
//         command {
//             argv "canopa-wifi-provider"
//         }
//     }
// }

// ─── On-screen display ───────────────────────────────────────────────────────
// Volume, microphone, brightness, keyboard-backlight and media keys run
// `canopa-shell volume up` and similar commands, bound in the session's Niri
// defaults. The Shell shows the new level on the focused output for a moment,
// also when another application or the firmware changes it.
// osd {
//     enabled #true        // #false keeps the keys working without the display
//     volume-step 5        // percent per press, 1-100
//     brightness-step 5    // perceptual percent per press, 1-50
//     timeout-ms 1500      // 500-10000
// }

// ─── Bar ─────────────────────────────────────────────────────────────────────
// One or more named bar sections. Each bar has a unique name (first argument).
// Multiple bars can target different outputs, or all outputs ("all").
//
// To add a second bar, duplicate this block with a different name and set the
// output field (see examples at the bottom).
bar "main" {
    // Which screen edge the bar anchors to.
    // Accepted values: "left" (default), "right", "top", "bottom".
    edge "left"

    // Compositor stacking layer for this bar's surfaces.
    // Accepted values: "background", "bottom", "top" (default), "overlay".
    // layer "top"

    // Bar width in logical pixels when collapsed. Minimum: 2.
    // The compositor multiplies by the output scale factor for physical rendering.
    thickness 64
    // 12 + 64 + 12 = 88 px of stable reserved space. Hover never resizes it.
    margin 12
    ui {
        background "spine"
        radius 28
        border width=1 color="border"
        padding 11 6
        gap 8
    }

    // Milliseconds of cursor dwell before a module's tooltip appears on hover.
    // Default: 500. Hide is always immediate on hover-exit.
    // tooltip-delay 500

    // Optional default style for all module format segments rendered in this bar.
    // Individual segment styles override these values property by property.
    // style color="text" size=12 weight="normal"

    // Actions on empty bar background.
    actions {
        click { open-panel }
        Super+Space { toggle-menu "Applications" }
    }

    // Zone layout — assign module names to start, center, and end zones.
    // Names must match the module declarations in the "modules" section below.
    // Multiple modules per zone: list them as separate string arguments on one line.
    modules {
        // Start zone: stacks from the leading edge of the bar.
        start "launcher" "overview" "workspaces"
        // Center zone: centered on the bar surface midpoint.
        // Add "media" to a zone for MPRIS now-playing and playback controls.
        // See docs/media.md; the module hides when no player is open.
        // The taskbar shows pinned applications, then the other open ones.
        center "taskbar"
        // End zone: stacks from the trailing edge of the bar.
        // Multiple modules: list as separate string arguments on the same line.
        // The tray shows one icon per StatusNotifierItem application. Network,
        // volume and battery are compact icons that hide while their service
        // (or the battery itself) is absent.
        // Network, volume and battery form one status group that opens Quick
        // settings; add "system" for a separate Quick settings button.
        end "tray" "network" "volume" "battery" "notifications" "clock"
    }

    // Default panel content for this bar.
    panel {
        // `title "My panel"` sets your own heading.
        title-id "shell-panel-quick-settings"
        // Use a drawer for browsing and a compact popover for individual modules.
        // "drawer" uses drawers for all panels; horizontal bars use auto sizing.
        presentation "adaptive"
        // "push-bar" puts the drawer at the edge and moves the bar inward.
        // Both modes overlay windows without resizing them.
        drawer-mode "overlay"
        width 416
        launcher-width 580
        ui { margin 12 0; radius 24; border width=1 color="border"; }
        // Adjacent switches pair into tiles: Wi-Fi and Bluetooth, then
        // Do Not Disturb and Keep awake.
        start "network" "bluetooth"
        center "notifications" "idle-inhibitor" "volume" "power-and-brightness"
        // Trailing buttons form a compact footer with two columns.
        // Hibernate appears only when logind answers CanHibernate with "yes".
        // Power & display shows the battery charge when there is a battery.
        end "media" "session-lock" "session-suspend" "session-power"
    }
}

// ─── Modules ─────────────────────────────────────────────────────────────────
// Declare each module referenced in bar.modules above.
// Module names must match exactly. Type is inferred from the name when the name
// matches a known type (workspaces, focused-window, minimap, battery, clock, network,
// volume, script, button). For custom names, add a "type" child node.
//
// Format templates can be written as quoted string segments:
//     format "{icon}" "{value}%"
// or as child `segment` nodes when you want per-segment styling:
//     format {
//         segment "{icon}" color="accent" size=18
//         segment "{value}%" weight="bold"
//     }
//
// Supported style props: color, size, weight.
// color accepts a theme token or #rrggbb/#rrggbbaa. Theme tokens:
// accent, text, subtext, base, surface0, surface1, border, overlay0,
// critical, warning, success.
// weight accepts: "light", "normal", "bold".
// Rotate formatted bar content. Values: "none", "auto", "clockwise", "counter-clockwise".
// "auto" rotates on left/right bars and stays unrotated on top/bottom bars.
//
// Optional actions override built-in behavior for that click type. Use launch
// for applications, command for bounded automation, or an operation like open-panel:
//     actions {
//         click { launch "my-application" }
//         right-click { command "my-other-command" }
//     }
//
// The built-in buttons name their texts with `label-id` and `tooltip-id` so
// they follow the session language. Replace them with `label "…"` and
// `tooltip "…"` for your own text (a module takes one or the other).
modules {
    // These are ordinary configurable buttons; the existing bar is the spine.
    module "launcher" {
        type "button"
        label-id "shell-module-search"
        icon "canopa:search"
        tooltip-id "shell-tooltip-launcher"
        ui { padding 11 0; foreground "accent"; }
        actions { click { toggle-menu "Applications"; } }
    }
    module "overview" {
        type "button"
        label-id "shell-module-overview"
        icon "canopa:overview"
        tooltip-id "shell-tooltip-overview"
        ui { padding 11 0; }
        actions { click { command { argv "niri" "msg" "action" "toggle-overview"; }; } }
    }
    module "system" {
        type "button"
        label-id "shell-module-controls"
        icon "canopa:controls"
        tooltip-id "shell-tooltip-quick-settings"
        ui { padding 11 0; }
        actions { click { toggle-bar-panel; } }
    }
    module "bluetooth" {
        type "button"
        label-id "shell-module-bluetooth"
        icon "canopa:bluetooth"
        actions { click { open-provider "bluetooth"; } }
    }
    module "power-and-brightness" {
        type "button"
        label-id "shell-module-power-and-display"
        icon "canopa:power-mode"
        actions { click { open-provider "power"; } }
    }
    // Session controls use ordinary buttons and can be rebound to another locker
    // or session manager. Launch lets the locker outlive the shell's command timeout.
    module "session-lock" {
        type "button"
        label-id "shell-module-lock"
        icon "canopa:lock"
        actions { click { launch "canopa-lock"; } }
    }
    // Suspend and hibernate keep the session, so they need no confirmation.
    module "session-suspend" {
        type "button"
        label-id "shell-module-suspend"
        icon "canopa:suspend"
        actions { click { session "suspend"; } }
    }
    module "session-power" {
        type "button"
        label-id "shell-module-power"
        icon "canopa:power-menu"
        actions { click { open-menu "Power"; } }
    }
    // Hibernate, Log out, Reboot and Power off are also ordinary buttons; add
    // them to the panel's end zone to reach them in one click.
    module "session-hibernate" {
        type "button"
        label-id "shell-module-hibernate"
        icon "canopa:hibernate"
        actions { click { session "hibernate"; } }
    }
    module "session-logout" {
        type "button"
        label-id "shell-module-log-out"
        icon "canopa:logout"
        actions { click { open-menu "Log out?"; } }
    }
    module "session-reboot" {
        type "button"
        label-id "shell-module-reboot"
        icon "canopa:reboot"
        actions { click { open-menu "Reboot?"; } }
    }
    module "session-poweroff" {
        type "button"
        label-id "shell-module-power-off"
        icon "canopa:poweroff"
        actions { click { open-menu "Power off?"; } }
    }
    module "media"
    // tray: StatusNotifierItem icons for background applications. Left click
    // activates an item, right click opens its menu. The Shell owns the
    // org.kde.StatusNotifierWatcher name while a tray module is placed.
    // Click focuses an application or launches it; clicking the focused one
    // cycles its windows; right- or middle-click opens another instance.
    // Pinned applications that are not installed are skipped.
    module "taskbar" {
        pinned "org.canopa.Files.desktop" "firefox.desktop" "org.canopa.Settings.desktop"
        ui { padding 2 0; }
    }
    module "tray" {
        // Show a filter field at the top of long tray menus.
        // menu-search #true
    }
    // Manual keep-awake control in Quick settings, initially off.
    module "idle-inhibitor"
    // Click opens the Center; right-click toggles DND.
    module "notifications" {
        ui { padding 9 0; }
    }
    // workspaces: Niri workspace indicators. Click or scroll to switch workspace.
    // Optional: assign labels and icons to specific workspace numbers (1-based).
    module "workspaces" {
        ui { padding 3 0; }
        // Optional display templates for workspace items.
        // Placeholders: {icon}, {value}, {index}, {name}, {label}, {state}.
        // format "{icon}{label}"
        // horizontal-format "{icon}"
        //
        // Styled workspace example. State values: focused, active, inactive.
        // format {
        //     segment "{icon}" {
        //         style color="text"
        //         style state="focused" color="base" weight="bold"
        //         style state="active" color="accent"
        //     }
        //     segment "{label}" {
        //         style color="subtext"
        //         style state="focused" color="base" weight="bold"
        //     }
        // }
        // horizontal-format {
        //     segment "{icon}" {
        //         style color="text"
        //         style state="focused" color="base" weight="bold"
        //     }
        // }
        // workspace 1 {
        //     label "main"
        //     icon  "󰣇"
        // }
        // workspace 2 {
        //     label "web"
        //     icon  "󰖟"
        // }
        //
        // Tooltip on hover. Same grammar as `format` (string segments or
        // styled `segment` block). Use `tooltip #false` to disable.
        // Omit to use the module's built-in default (none for workspaces).
        // The shipped tooltip is the built-in text "Workspace {index}".
        tooltip-id "shell-tooltip-workspace"
    }

    // focused-window: shows the title of the focused window on this output.
    module "focused-window" {
        actions { click { open-panel; } }
        // Optional display templates. Placeholders: {icon}, {value}, {title}, {app-id}.
        format "{icon}" "{title}"
        content-rotation "auto"
        fallback-icon "□"
        // Title length including the middle ellipsis; 0 disables truncation.
        // Counts displayed characters, preserving emoji and combining marks.
        max-length 50
        // expanded-format "{title}"
        // horizontal-format "{title}"
        //
        // Styled focused-window example.
        // expanded-format {
        //     segment "{title}" color="text" weight="bold"
        // }
        // horizontal-format {
        //     segment "{title}" color="text"
        // }
        // actions {
        //     click { command "niri msg action focus-window-up" }
        //     right-click { command "niri msg action close-window" }
        // }
        //
        // Tooltip on hover. Same grammar as `format`. Use `tooltip #false`
        // to disable. Omit to use the built-in default ("{title}").
        // tooltip "{title}"
    }

    // volume: audio output level indicator. Scroll on the module to adjust volume.
    // Network, volume and battery form the spine's status group; each opens
    // Quick settings, where Wi-Fi, Sound and Power & display lead further.
    module "volume" {
        actions { click { toggle-bar-panel; } }
        // Volume adjustment per scroll event, as a percentage. Range: 1–100. Default: 5.
        step 5
        //
        // Optional `states` block: declare custom volume states. The built-in
        // numeric state is `unmuted` (threshold 100); `muted` is set when the
        // sink is muted and short-circuits ahead of the numeric resolution.
        // states {
        //     state "quiet" threshold=33
        //     state "loud"  threshold=100
        // }
        // Optional display templates. Placeholders: {icon}, {value}, {percent}, {state}.
        // format "{icon}"
        // expanded-format "{icon} {value}%"
        // horizontal-format "{icon} {value}%"
        //
        // Styled volume example. State values: muted, unmuted.
        // format {
        //     segment "{icon}" {
        //         style color="accent"
        //         style state="muted" color="overlay0"
        //     }
        // }
        // expanded-format {
        //     segment "{icon}" {
        //         style color="accent"
        //         style state="muted" color="overlay0"
        //     }
        //     segment "{value}%" color="subtext"
        // }
        // Optional state/value icons. Thresholds mean "at or above".
        // icons {
        //     icon "✕" state="muted"
        //     icon "░" at=1
        //     icon "▓" at=33
        //     icon "◈" at=66
        // }
        //
        // Tooltip on hover. Same grammar as `format`. Use `tooltip #false`
        // to disable. Omit to use the built-in default ("{value}%").
        // tooltip "{value}%"
    }

    // network: network connectivity status (connected/disconnected/interface type).
    module "network" {
        actions { click { toggle-bar-panel; } }
        // Optional default provider for rich network controls.
        // If no click action is configured, clicking the network module opens
        // the shipped Wi-Fi provider. Override with another provider name or
        // disable with `provider #false`.
        // provider "wifi"
        // Optional display templates. Placeholders: {icon}, {value}, {label}, {state}.
        // format "{icon}"
        // expanded-format "{icon} {label}"
        // horizontal-format "{icon} {state}"
        //
        // Styled network example. State values: full, limited, none.
        // format {
        //     segment "{icon}" {
        //         style color="accent"
        //         style state="limited" color="warning"
        //         style state="none" color="critical"
        //     }
        // }
        // expanded-format {
        //     segment "{icon}" {
        //         style color="accent"
        //         style state="limited" color="warning"
        //         style state="none" color="critical"
        //     }
        //     segment "{label}" color="subtext"
        // }
        // Optional connectivity-state icons.
        // icons {
        //     icon "◆" state="full"
        //     icon "◈" state="limited"
        //     icon "✕" state="none"
        // }
        //
        // Tooltip on hover. Same grammar as `format`. Use `tooltip #false`
        // to disable. Omit to use the built-in default ("{label}").
        // tooltip "{label}"
    }

    // battery: charge level and charging/discharging state.
    module "battery" {
        actions { click { toggle-bar-panel; } }
        // Percentage at or below which the critical badge and alert color appear.
        // Range: 0–100. Default: 15.
        critical-threshold 15
        //
        // Optional `states` block: declare custom states or override built-in
        // thresholds. Each `state` has a name and an upper-bound `threshold`.
        // The active state is the one with the smallest threshold ≥ value.
        // Built-ins: critical (15), low (30), normal (100). User entries with
        // a built-in name replace it; new names are added.
        // states {
        //     state "critical" threshold=10
        //     state "needs-charge" threshold=60
        // }
        // Optional display templates. Placeholders: {icon}, {value}, {percent}, {state}.
        // format "{icon}"
        // expanded-format "{icon} {value}%"
        // horizontal-format "{icon} {value}%"
        //
        // Styled battery example. State values: charging, critical, low, normal.
        // format {
        //     segment "{icon}" {
        //         style color="accent"
        //         style state="charging" color="success"
        //         style state="critical" color="critical"
        //         style state="low" color="warning"
        //     }
        // }
        // expanded-format {
        //     segment "{icon}" {
        //         style color="accent"
        //         style state="charging" color="success"
        //         style state="critical" color="critical"
        //         style state="low" color="warning"
        //     }
        //     segment "{value}%" color="subtext" weight="bold"
        // }
        // Optional state/value icons. State icons take precedence over thresholds.
        // icons {
        //     icon "⚡" state="charging"
        //     icon "▏" at=0
        //     icon "░" at=16
        //     icon "▒" at=31
        //     icon "▓" at=61
        //     icon "█" at=96
        // }
        //
        // Tooltip on hover. Same grammar as `format`. Use `tooltip #false`
        // to disable. Omit to use the built-in default ("{value}% {state}").
        // tooltip "{value}% {state}"
    }

    // clock: current time and date display.
    module "clock" {
        ui { padding 16 0; }
        format "{time}"
        actions { click { open-panel; } }
        // Time format string using chrono strftime syntax. Without one, the
        // clock follows the language's time format and hour cycle ("14:30"
        // in French, "2:30 PM" in US English).
        // time-format "%H:%M"         // 24-hour; "%-I:%M %p" for 12-hour
        // Date format string using chrono strftime syntax. Without one, the
        // date follows the language ("Wednesday, November 11").
        // date-format "%A, %-d %B"
        // Optional display templates. Placeholders: {icon}, {value}, {time}, {date}.
        // format "{icon} {time}"
        // expanded-format "{icon} {time}\n{date}"
        // horizontal-format "{icon} {time}"
        //
        // Styled clock example.
        // format {
        //     segment "{icon}" color="accent"
        //     segment "{time}" color="text" weight="bold"
        // }
        // expanded-format {
        //     segment "{time}" color="text" weight="bold"
        //     segment "{date}" color="subtext"
        // }
        // actions {
        //     click { launch "gnome-clocks" }
        //     right-click { command "notify-send \"$(date)\"" }
        // }
        //
        // Tooltip on hover. Same grammar as `format`. Use `tooltip #false`
        // to disable. Omit to use the built-in default ("{date}").
        // tooltip "{date}"
    }

    // script: run a shell command periodically and show stdout.
    // module "script" {
    //     command "date"
    //     interval 5
    //     // Optional display templates. Placeholders: {icon}, {value}, {output}.
    //     format "{icon} {value}"
    //     expanded-format "{icon} {output}"
    //     horizontal-format "{icon} {output}"
    //     //
    //     // Styled script example.
    //     // format {
    //     //     segment "{icon}" color="accent"
    //     //     segment "{output}" color="text"
    //     // }
    //     //
    //     // Tooltip on hover. Same grammar as `format`. Use `tooltip #false`
    //     // to disable. Omit for no tooltip (script has no built-in default).
    //     // tooltip "{output}"
    // }

    // button: user-defined clickable action.
    // module "button" {
    //     label "Launch"
    //     icon ">"
    //     // Optional display templates. Placeholders: {icon}, {value}, {label}.
    //     format "{icon}"
    //     expanded-format "{icon} {label}"
    //     horizontal-format "{icon} {label}"
    //     //
    //     // Styled button example.
    //     // format {
    //     //     segment "{icon}" color="accent" weight="bold"
    //     // }
    //     // expanded-format {
    //     //     segment "{icon}" color="accent"
    //     //     segment "{label}" color="text" weight="bold"
    //     // }
    //     actions {
    //         click { launch "kitty" }
    //         right-click { command "notify-send Launch" }
    //     }
    //     //
    //     // Tooltip on hover. Same grammar as `format`. Use `tooltip #false`
    //     // to disable. Omit for no tooltip (button has no built-in default).
    //     // tooltip "{label}"
    // }
}

// ─── Multiple bars ───────────────────────────────────────────────────────────
// Add more "bar" sections to display additional bars on the same or different
// outputs. The output name must match the Wayland output name — run
// `niri msg outputs` to list connected output names.
//
// Each bar must have a unique name. The "output" field defaults to "all"
// (appears on every connected output). Use exact Output names to include only
// those Outputs, or prefix every name with "!" to exclude those Outputs.
//
// Example: horizontal bar on a secondary monitor only
// bar "top-strip" {
//     output "DP-2"
//     edge "top"
//     collapsed-width 32
//     modules {
//         start "workspaces"
//         center "focused-window"
//         end "clock"
//     }
// }
//
// Example: bar on every Output except the laptop panel
// bar "external-side" {
//     output "!eDP-1"
//     edge "left"
// }
//
// Example: bar on either of two exact Outputs
// bar "desk-strip" {
//     output "DP-2" "HDMI-A-1"
//     edge "top"
// }
//
// Example: two bars on the same output
// bar "side" {
//     output "eDP-1"
//     edge "left"
//     collapsed-width 48
// }
// bar "top" {
//     output "eDP-1"
//     edge "top"
//     collapsed-width 32
// }
